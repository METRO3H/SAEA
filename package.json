{
   "name": "saea",
   "type": "module",
   "version": "0.0.1",
   "scripts": {
      "start": "astro dev",
      "build": "astro check && astro build",
      "preview": "astro preview",
      "astro": "astro",
      "watcher": "nodemon --watch src/**/* -e js,ts,astro --exec npm run build",
      "server_old": "nodemon server/server_old.js",
      "server:check": "tsc --noEmit --incremental -p ./server/tsconfig.json",
      "server:fearless": "tsx --tsconfig ./server/tsconfig.json ./server/server.ts",
      "server": "nodemon --watch server --ignore server/test --ext ts,js --exec \"npm run server:check && npm run server:fearless\"",
      "dev": "astro dev",
      "test": "nodemon src/content/Test/main.js",
      "stest": "nodemon ./server/test.ts"
   },
   "dependencies": {
      "@astrojs/mdx": "^2.1.1",
      "@astrojs/node": "^8.1.0",
      "@astrojs/react": "^3.0.9",
      "@astrojs/rss": "^4.0.4",
      "@astrojs/sitemap": "^3.0.5",
      "@google-cloud/local-auth": "^3.0.1",
      "@googleapis/forms": "^2.0.5",
      "@nanostores/react": "^0.7.3",
      "@types/jsonwebtoken": "^9.0.8",
      "@types/react": "^18.2.52",
      "@types/react-dom": "^18.2.18",
      "astro": "^4.2.8",
      "bootstrap": "^5.3.3",
      "chalk": "^5.3.0",
      "chart.js": "^4.4.1",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.5",
      "date-fns": "^4.1.0",
      "dotenv": "^16.4.7",
      "express": "^4.21.2",
      "faker": "^5.5.3",
      "google-auth-library": "^9.15.1",
      "googleapis": "^144.0.0",
      "jsonwebtoken": "^9.0.2",
      "mdb-ui-kit": "^7.1.0",
      "mysql2": "^3.12.0",
      "nanostores": "^0.11.3",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "sass": "^1.78.0",
      "sqlite3": "^5.1.7",
      "uuid": "^10.0.0"
   },
   "devDependencies": {
      "@types/bootstrap": "^5.2.10",
      "@types/cookie-parser": "^1.4.8",
      "@types/cors": "^2.8.17",
      "@types/express": "^4.17.21",
      "@types/node": "^22.10.5",
      "nodemon": "^3.0.3",
      "npm-run-all": "^4.1.5",
      "tsx": "^4.19.2",
      "typescript": "^5.7.2"
   },
   "imports": {
      "#models": "./src/db/models/index.js",
      "#utils": "./src/lib/utils.js",
      "#constants": "./src/lib/constants.js"
   }
}
