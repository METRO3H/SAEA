---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../const";
import { Image } from "astro:assets";
import add_file from "../assets/svg/add_file.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <Image src={add_file} alt="add-quiz" width="200" />
      <a type="button" href="/create_quiz" class="btn btn-primary btn-lg" data-mdb-ripple-init
        >Crear quiz</a
      >
    </main>
    <Footer />
  </body>
</html>
