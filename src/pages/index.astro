---
import BaseHead from "@layouts/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../const";
import { Image } from "astro:assets";
import google_form_icon_240px from "../assets/svg/google-form-icon-240px.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <Image src={google_form_icon_240px} alt="add-quiz" width="200" />
      <a
        type="button"
        href="/quiz/create"
        id="create-form-button"
        class="btn btn-lg"
        data-mdb-ripple-init>Crear quiz</a
      >
    </main>
    <Footer />
    <style>
      main {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
      }
      #create-form-button {
        /* background: var(--main-color-blue) !important; */
        border: 2px solid var(--accent);
        color: var(--accent);
      }
    </style>
  </body>
</html>
