---
import Document from "../layouts/document.astro";

const session_token = Astro.cookies.has("session_token") ? Astro.cookies.get("session_token") : false;

if (Astro.cookies.has("session_token")) {
   return Astro.redirect("/quiz/view/all");
}
---

<Document title="Login" show_header={false}>
   <div class="login-wrapper">
      <!-- Panel izquierdo adaptado para SAEA con imagen de fondo de estudiantes -->
      <div class="left-section">
         <div class="left-content">
            <h1>📊SAEA</h1>
            <p>Potencia tus evaluaciones con análisis inteligente de datos educativos</p>
         </div>
      </div>

      <!-- Panel derecho actualizado con branding SAEA y beneficios para profesores -->
      <div class="right-section">
         <div class="login-form">
            <div class="logo">
               <h2>📊 SAEA</h2>
               <p>Sistema de Análisis Educativo y Autoevaluación</p>
            </div>

            <div class="welcome-text">
               <h3>Bienvenido profesor</h3>
               <p>Inicia sesión para gestionar tus evaluaciones</p>
            </div>

            <button class="google-button" onclick="client.requestCode()">
               <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path
                     d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                     fill="#4285F4"></path>
                  <path
                     d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                     fill="#34A853"></path>
                  <path
                     d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                     fill="#FBBC05"></path>
                  <path
                     d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                     fill="#EA4335"></path>
               </svg>
               Continuar con Google
            </button>

            <div class="divider">
               <span>Herramientas para educadores</span>
            </div>

            <!-- Features actualizadas para enfocarse en crear forms y análisis de estudiantes -->
            <div class="features">
               <div class="feature-item">
                  <svg
                     class="feature-icon"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg"
                  >
                     <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                     ></path>
                  </svg>
                  <span>Crea Google Forms personalizados rápidamente</span>
               </div>
               <div class="feature-item">
                  <svg
                     class="feature-icon"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg"
                  >
                     <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                     ></path>
                  </svg>
                  <span>Analiza resultados de estudiantes en profundidad</span>
               </div>
               <div class="feature-item">
                  <svg
                     class="feature-icon"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24"
                     xmlns="http://www.w3.org/2000/svg"
                  >
                     <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2-2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                     ></path>
                  </svg>
                  <span>Genera reportes detallados de desempeño académico</span>
               </div>
            </div>

            <div class="footer-text">
               ¿Problemas para acceder? <a href="#">Obtener ayuda</a>
            </div>
         </div>
      </div>
   </div>
</Document>

<!-- Estilos actualizados con el color principal #6200ee de SAEA -->
<style>
   .login-wrapper {
      display: flex;
      height: 100%;
      height: 100vh;
   }

   /* Agregando imagen de fondo de estudiantes con overlay */
   .left-section {
      flex: 1;
      background-image:
         linear-gradient(135deg, rgba(98, 0, 238, 0.85) 0%, rgba(74, 0, 180, 0.85) 100%),
         url("/src/assets/images/students.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem;
      position: relative;
      overflow: hidden;
   }

   .left-section::before {
      content: "";
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      opacity: 0.1;
      animation: float 20s ease-in-out infinite;
   }

   @keyframes float {
      0%,
      100% {
         transform: translate(0, 0) rotate(0deg);
      }
      50% {
         transform: translate(20px, 20px) rotate(5deg);
      }
   }

   .left-content {
      position: relative;
      z-index: 1;
      text-align: center;
      color: white;
   }

   .left-content h1 {
      font-size: 4rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
      color: #ffffff;
      letter-spacing: 4px;
   }

   .left-content p {
      font-size: 1.5rem;
      line-height: 1.6;
      color: #ffffff;
      text-shadow: 0 3px 15px rgba(0, 0, 0, 0.4);
      font-weight: 500;
      max-width: 550px;
      margin: 0 auto;
   }

   .right-section {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem;
      background: #ffffff;
   }

   .login-form {
      width: 100%;
      max-width: 420px;
   }

   .logo {
      text-align: center;
      margin-bottom: 2.5rem;
   }

   .logo h2 {
      font-size: 2rem;
      color: #1a202c;
      font-weight: 700;
      margin-bottom: 0.5rem;
   }

   .logo p {
      color: #718096;
      font-size: 1rem;
   }

   .welcome-text {
      text-align: center;
      margin-bottom: 2rem;
   }

   .welcome-text h3 {
      font-size: 1.75rem;
      color: #2d3748;
      margin-bottom: 0.5rem;
      font-weight: 600;
   }

   .welcome-text p {
      color: #718096;
      font-size: 0.95rem;
   }

   .google-button {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 1rem;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      background: white;
      color: #2d3748;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 150ms ease;
      text-decoration: none;
   }

   .google-button:hover {
      border-color: #6200ee;
      background: #f7fafc;
      box-shadow: 0 10px 25px rgba(98, 0, 238, 0.2);
   }

   .google-icon {
      width: 24px;
      height: 24px;
   }

   .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 2rem 0;
      color: #a0aec0;
      font-size: 0.875rem;
   }

   .divider::before,
   .divider::after {
      content: "";
      flex: 1;
      border-bottom: 1px solid #e2e8f0;
   }

   .divider span {
      padding: 0 1rem;
   }

   .features {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid #e2e8f0;
   }

   .feature-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      color: #4a5568;
      font-size: 0.9rem;
   }

   .feature-icon {
      width: 20px;
      height: 20px;
      color: #6200ee;
      flex-shrink: 0;
   }

   .footer-text {
      text-align: center;
      margin-top: 2rem;
      color: #a0aec0;
      font-size: 0.875rem;
   }

   .footer-text a {
      color: #6200ee;
      text-decoration: none;
      font-weight: 500;
   }

   .footer-text a:hover {
      text-decoration: underline;
   }

   @media (max-width: 968px) {
      .login-wrapper {
         flex-direction: column;
      }

      .left-section {
         display: none;
      }

      .right-section {
         padding: 2rem 1.5rem;
      }
   }
</style>
<script is:inline src="https://accounts.google.com/gsi/client"></script>

<script is:inline>
   const client = google.accounts.oauth2.initCodeClient({
      client_id: "706618631917-btquac8lmool5kc1ph5709eqsb0ocluq.apps.googleusercontent.com",
      scope: "https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/forms.body https://www.googleapis.com/auth/forms.responses.readonly",
      ux_mode: "popup",
      callback: Handle_Response_Code,
   });

   function Handle_Response_Code(google_response) {
      fetch("request/oauth2/google/login", {
         method: "POST",
         headers: {
            "Content-Type": "application/x-www-form-urlencoded",
            "X-Requested-With": "XmlHttpRequest",
         },
         credentials: "include",
         body: "code=" + google_response.code,
      })
         .then((response) => response.json())
         .then((data) => {
            if (data.success) {
               window.location.reload();
            } else {
               console.error("Auth error:", data.error);
            }
         })
         .catch((error) => console.error("Error:", error));
   }
</script>
