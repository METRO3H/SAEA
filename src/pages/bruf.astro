---
import Document from "../layouts/document.astro";
import SpecialInputText from "../components/special_input_text.jsx";
---

<Document>
  <div class="custom-container">
    <div id="quiz-title">
      <SpecialInputText
        input_label="Título del cuestionario"
        input_width="50%"
        input_height="60px"
        input_font_size="31px"
      />
    </div>
    <table
      class="table align-middle mb-0 bg-white table-hover table-bordered align-middle caption-top"
    >
      <caption>
        <SpecialInputText input_label="Asignatura" input_width="20%" />
      </caption>
      <thead class="table-dark">
        <tr>
          <th id="col-axis">Eje</th>
          <th id="col-content">Contenidos</th>
          <th id="col-objective">Objetivos</th>
          <th id="col-classes" class="text-center">Clases</th>
          <th id="col-percentage" class="text-center">%</th>
          <th
            class="cell"
            title="Ingresa una habilidad que quieras evaluar. Ej: Aplicación, Conocimiento, Análisis, etc."
            ><input
              class="text-white text-center"
              type="text"
              placeholder="Habilidad"
              required
            /></th
          >
          <th
            class="cell"
            title="Ingresa una habilidad que quieras evaluar. Ej: Aplicación, Conocimiento, Análisis, etc."
            ><input
              class="text-white text-center"
              type="text"
              placeholder="Habilidad"
              required
            /></th
          >
          <th
            class="cell"
            title="Ingresa una habilidad que quieras evaluar. Ej: Aplicación, Conocimiento, Análisis, etc."
            ><input
              class="text-white text-center"
              type="text"
              placeholder="Habilidad"
              required
            /></th
          >
          <th><div class="text-center">Total preguntas</div></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td rowspan="3" class="cell" title="Ingrese un eje a evaluar. Ej: Números">
            <input type="text" placeholder="Ej: Geometría" required />
          </td>
          <td class="cell">
            <input type="text" placeholder="Ingresa un objetivo" required />
          </td>
          <td
            class="cell"
            title="Ingresa la cantidad de clases realizadas con respecto a este contenido. Ej: 4"
          >
            <input class="text-center" type="text" placeholder="Ej: 2" required />
          </td>
          <td class="text-center">-</td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="number" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="text-center">-</td>
        </tr>
        <tr>
          <td class="cell">
            <input type="text" placeholder="Ingresa un objetivo" required />
          </td>
          <td
            class="cell"
            title="Ingresa la cantidad de clases realizadas con respecto a este contenido. Ej: 4"
          >
            <input class="text-center" type="text" placeholder="Ej: 2" required />
          </td>
          <td class="text-center">-</td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="number" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="text-center">-</td>
        </tr>
        <tr>
          <td class="cell">
            <input type="text" placeholder="Ingresa un objetivo" required />
          </td>
          <td
            class="cell"
            title="Ingresa la cantidad de clases realizadas con respecto a este contenido. Ej: 4"
          >
            <input class="text-center" type="text" placeholder="Ej: 2" required />
          </td>
          <td class="text-center">-</td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="number" placeholder="-" required />
          </td>
          <td class="cell" title="Ingresa la cantidad de preguntas que tendra este item. Ej: 3">
            <input class="text-center" type="text" placeholder="-" required />
          </td>
