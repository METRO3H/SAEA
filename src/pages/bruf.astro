---
import Document from "../layouts/document.astro";
import SpecialInputText from "../components/special_input_text.jsx";
import Custom_table from "../components/table/table";
---

<Document>
  <div class="custom-container">
    <div id="quiz-title">
      <SpecialInputText
        input_label="Título del cuestionario"
        input_width="50%"
        input_height="60px"
        input_font_size="31px"
      />
    </div>

    <Custom_table />
  </div>
</Document>

<style>
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    max-width: 95%;
    height: 100%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-top: 1rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>(".cell input").forEach((input: HTMLInputElement) => {
    input.addEventListener("mouseover", function () {
      if (input.offsetWidth < input.scrollWidth) {
        const parent = input.parentNode as HTMLElement;
        input.title = input.value;
        if (!parent.classList.contains("cell-hint")) {
          parent.setAttribute("title", input.value);
          document.documentElement.style.setProperty("--display-before-after", "block");
        }

        console.log(input.value);
      } else {
        console.log("BRUFA2");
        document.documentElement.style.setProperty("--display-before-after", "none");
      }
    });
  });
</script>
