            <input class="text-center" type="text" placeholder="-" required />
          </td>
          <td class="text-center">-</td>
        </tr>
      </tbody>
      <tfoot
        ><tr>
          <td colspan="3" class="text-center">TOTAL</td>
          <td class="text-center">-</td>
          <td class="text-center">100</td>
          <td class="text-center">-</td>
          <td class="text-center">-</td>
          <td class="text-center">-</td>
          <td class="text-center">-</td>
        </tr>
      </tfoot>
    </table>
  </div>
</Document>

<style>
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    max-width: 95%;
    height: 100%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-top: 1rem;
  }
  caption {
    padding: 0.5rem 0rem;
  }
  table {
    height: fit-content;
  }

  .cell {
    position: relative;
    height: 0;
    padding-top: 0;
    padding-bottom: 0;
  }
  .cell > input {
    background-color: transparent;
    width: 100%;
    height: 100%;
    border: none;
    outline: none;
  }
  #col-axis {
    width: 11%;
  }
  #col-content {
    width: 17%;
  }
  #col-objective {
    width: 21%;
  }

  #col-classes {
    width: 6%;
    max-width: 70px;
  }
  #col-percentage {
    width: 5%;
    max-width: 40px;
  }
  thead > tr > th {
    padding-left: 0;
    padding-right: 0;
  }
  tbody > tr > td {
    padding-left: 0;
    padding-right: 0;
  }
  #col-axis,
  #col-content,
  #col-objective,
  tbody > tr > :nth-child(1) > input,
  tbody > tr > :nth-child(2) > input {
    padding-left: 0.7rem;
  }

  tbody > tr > :nth-child(3) > input,
  tbody > tr > :nth-child(4) {
    font-family: Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
    font-size: 14.4px !important;
  }

  th,
  td {
    cursor: default;
  }
  thead > tr > :last-child {
    padding-top: 0;
    padding-bottom: 0;
    height: 0px;
    width: 8%;
  }
  thead > tr > :last-child > div {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  thead > tr > .cell {
    min-width: 80px;
  }

  input::placeholder {
    opacity: 60%;
  }
  input {
    text-overflow: ellipsis;
  }

  tfoot > tr > td {
    padding: 0;
    background: rgb(92, 87, 87);
    color: white;
  }
  @media (max-width: 768px) {
    thead > tr > :nth-child(1) {
      padding-left: 0;
      text-align: center;
    }
    tbody > tr > :nth-child(1) {
      padding-left: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>(".cell input").forEach((input: HTMLInputElement) => {
    input.addEventListener("mouseover", function () {
      if (input.offsetWidth < input.scrollWidth) {
        const parent = input.parentNode as HTMLElement;
        input.title = input.value;
        if (!parent.classList.contains("cell-hint")) {
          parent.setAttribute("title", input.value);
          document.documentElement.style.setProperty("--display-before-after", "block");
        }

        console.log(input.value);
      } else {
        console.log("BRUFA2");
        document.documentElement.style.setProperty("--display-before-after", "none");
      }
    });
  });
</script>
