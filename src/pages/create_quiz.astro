---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AddItemButton from "../components/add_item_button.astro";
import QuestionListItem from "../components/question/question_list_item.astro";
---

<html lang="en">
  <head>
    <BaseHead title="Crear Quiz" description="Crear Quiz" />
  </head>
  <body>
    <Header />
    <main>
      <div id="question-card-container">
        <div id="question-list-container">
          <QuestionListItem question_list_item_name="Pregunta 56" />
        </div>
        <div id="question-content-container">
          <div class="tab-content">

            <div
              class="tab-pane fade"
              id="list-profile"
              role="tabpanel"
              aria-labelledby="list-profile-list"
            >
              Some placeholder content in a paragraph relating to "Profile". And
              some more content, used here just to pad out and fill this tab
              panel. In production, you would obviously have more real content
              here. And not just text. It could be anything, really. Text,
              images, forms.
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer />
    <style>
      #question-card-container {
        display: grid;
        grid-template-columns: 1fr 5fr;
        width: 805px;
        height: 90%;
        margin: 0;
        padding: 0;
        background: white;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
        border-radius: 11px;
      }
      #question-list-container {
        width: 180px;
        padding: 0;
      }
      #question-content-container {
        display: flex;
        flex-direction: column;
        padding-left: 21px;
        padding-right: 21px;

        margin-top: 11px;
      }
      .form-outline {
        padding-top: 8px;
      }

      @media (max-width: 805px) {
        #question-card-container {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
