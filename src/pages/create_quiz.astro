---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuestionListItem from "../components/question/question_list_item.astro";
import QuestionContentItem from "../components/question/question_content_item.astro";
import { question_number } from "../components/question/const_var";
---

<html lang="en">
  <head>
    <BaseHead title="Crear Quiz" description="Crear Quiz" />
  </head>
  <body>
    <Header />
    <main>
      <div id="question-card-container">
        <div id="question-list-container">
          <div class="list-group list-group-light" id="list-tab" role="tablist">
            <QuestionListItem
              question_list_item_number={question_number}
              add_class="active"
            />

            <QuestionListItem question_list_item_number={question_number + 1} />
            <QuestionListItem question_list_item_number={question_number + 2} />
            <QuestionListItem question_list_item_number={question_number + 3} />
          </div>
        </div>

        <div id="question-content-container">
          <div class="tab-content">
            <QuestionContentItem
              question_content_item_number={question_number}
              add_class="active"
            />
            <QuestionContentItem
              question_content_item_number={question_number + 1}
            />
            <QuestionContentItem
              question_content_item_number={question_number + 2}
            />
            <QuestionContentItem
              question_content_item_number={question_number + 3}
            />

            <!--             <div
              class="tab-pane fade"
              id="list-profile"
              role="tabpanel"
              aria-labelledby="list-profile-list"
            >
              Some placeholder content in a paragraph relating to "Profile". And
              some more content, used here just to pad out and fill this tab
              panel. In production, you would obviously have more real content
              here. And not just text. It could be anything, really. Text,
              images, forms.
            </div> -->
          </div>
        </div>
      </div>
    </main>

    <Footer />
    <style>
      #question-card-container {
        display: grid;
        grid-template-columns: 1fr 5fr;
        width: 805px;
        height: 90%;
        margin: 0;
        padding: 0;
        background: white;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
        border-radius: 11px;
      }
      #question-list-container {
        width: 180px;
        padding: 0;
      }
      #question-content-container {
        display: flex;
        flex-direction: column;
        padding-left: 21px;
        padding-right: 21px;

        margin-top: 11px;
      }

      @media (max-width: 805px) {
        #question-card-container {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
