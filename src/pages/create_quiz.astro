---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuestionListItem from "../components/question/question_list_item.astro";
import QuestionContentItem from "../components/question/question_content_item.astro";
import {question_number} from "../components/question/const_var";
---

<html lang="en">
  <head>
    <BaseHead title="Crear Quiz" description="Crear Quiz" />
  </head>
  <body>
    <Header />
    <main>
      <div id="question-card-container">
        <div id="question-list-container">
          <div class="list-group list-group-light" id="list-tab" role="tablist">
            <QuestionListItem
              question_list_item_number={question_number}
              add_class="active"
            />

            <QuestionListItem question_list_item_number={question_number + 1} />

          </div>
        </div>

        <div id="question-content-container">
          <div class="tab-content">
            <QuestionContentItem
              question_content_item_number={question_number}
              add_class="active"
            />
            <QuestionContentItem
              question_content_item_number={question_number + 1}
            />
          </div>
        </div>
      </div>
    </main>
    <Footer />
    <style>
      #question-card-container {
        display: grid;
        grid-template-columns: 1fr 5fr;
        width: 805px;
        min-height: 95%;
        margin: 0;
        padding: 0;
        background: white;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
        border-radius: 11px;
      }
      #question-list-container {
        width: 180px;
        padding: 0;
      }
      #question-content-container {
        display: flex;
        flex-direction: column;
        padding-left: 21px;
        padding-right: 21px;
        margin-top: 11px;
      }

      @media (max-width: 805px) {
        #question-card-container {
          width: 100%;
        }
      }
    </style>
    <script>
      document.querySelectorAll(".save-question-item")!.forEach((button) => {
        button.addEventListener("click", function (event: MouseEvent) {
          event.preventDefault(); // Prevenir el comportamiento predeterminado del botón

          const data_form = Get_Data_Form();
          console.log(data_form);
          Start_Animation();
          fetch("/request/create_form", {
            method: "POST",
            headers: {"content-type": "application/json"},
            body: JSON.stringify(data_form),
          })
            .then((response) => {
              if (!response.ok) {
                return response.json().then((errorResponse) => {
                  throw errorResponse.message || "Error en la solicitud"
                  
                });
              }
              return response.json();
            })
            .then((data) => {
              End_Animation(data.message, false);
            })
            .catch((error) => {
              console.error(error);
              End_Animation(error, true);
            });
        });
      });

      function Get_Data_Form() {
        const questions = document.querySelectorAll(".question-content-item");

        const data_form: {
          question: String;
          answers: object;
        }[] = [];

        questions.forEach((question_item) => {
          // Obtener todas las respuestas dentro de la pregunta
          const question_text = (
            question_item.querySelector(
              ".question-input-text"
            ) as HTMLTextAreaElement
          ).value;

          const answers = question_item.querySelectorAll(
            ".question-answers .form-check"
          );

          // Crear un array para almacenar las respuestas y si están marcadas como correctas
          const answers_data: {
            answer: string;
            is_correct: boolean;
          }[] = [];
          answers.forEach((answer, index) => {
            const answer_text = (
              answer.querySelector(".answer-input-text") as HTMLInputElement
            ).value;
            const answer_value = (
              answer.querySelector(".answer-input-box") as HTMLInputElement
            ).checked;

            // Agregar la pregunta y si es correcta al array de datos
            answers_data.push({
              answer: answer_text,
              is_correct: answer_value,
            });
          });

          data_form.push({
            question: question_text,
            answers: answers_data,
          });
        });

        return data_form;
      }

      import {Modal} from "bootstrap";

      function Start_Animation() {
        const modal = new Modal("#staticBackdrop");
        modal.show();

        return false;
      }

      function End_Animation(message, is_error) {
        (
          document.querySelector(".check-mark") as HTMLDivElement
        ).style.display = "block";

        document.documentElement.style.setProperty("--cicleFlow", "forwards");
        document.documentElement.style.setProperty(
          "--finalBorder",
          "rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231)"
        );
        document.documentElement.style.setProperty(
          "--h1Animation",
          "h1-animation-2"
        );

        const modal_message_container = document.querySelector(
          "#modal-message-container"
        ) as HTMLElement;

        if (is_error) {
          modal_message_container.innerHTML = `
            <h3 id="modal-message-text"> ${message} </h3>
          `;
          return;
        }

        modal_message_container.innerHTML = ` 
        <a class="btn btn-primary text-white btn-link-form" data-mdb-ripple-init href="${message}" role="button" target="_blank" title="${message}">
  <i class="fab fa-google me-2 fa-2x"></i>
  <span> Link del formulario </span>
  
</a> `;

        return;
      }
    </script>
  </body>
</html>
