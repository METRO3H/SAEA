---
import Document from "../layouts/document.astro";
---

<Document title="Auth">
   <section id="auth">

      <button onclick="client.requestCode();">Authorize with Google</button>

   </section>
</Document>

<style>
   #auth {
      display: flex;.
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 100%;
   }
</style>
<!-- <script src="https://accounts.google.com/gsi/client" async defer></script> -->
<script is:inline src="https://accounts.google.com/gsi/client" ></script>


<script is:inline>
const client = google.accounts.oauth2.initCodeClient({
  client_id: '706618631917-btquac8lmool5kc1ph5709eqsb0ocluq.apps.googleusercontent.com',
  scope: 'https://www.googleapis.com/auth/calendar.readonly',
  ux_mode: 'popup',
  callback: Handle_Response_Code,
});

function Handle_Response_Code(google_response) {
   
   fetch("request/auth/google", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XmlHttpRequest' // Manteniendo la cabecera CSRF
      },
      body: 'code=' + google_response.code
    })
    .then(response => response.text()) // Si esperas una respuesta de texto
    .then(text => console.log('Auth code response: ' + text))
    .catch(error => console.error('Error:', error));
}

</script>

