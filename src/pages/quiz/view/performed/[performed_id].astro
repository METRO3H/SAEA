---
import Card from "@components/card.astro";
import { Get_Profile_Data } from "@handlers/get_profile_data";
import Document from "@layouts/document.astro";

if (!Astro.cookies.has("session_token")) return Astro.redirect("/login");
const session_token = Astro.cookies.get("session_token")?.value as string;
const profile_data = await Get_Profile_Data(session_token);
const quiz_structure_url = Astro.url.origin + "/quiz/create/performed/" + Astro.params.performed_id;
---

<Document title="Quiz realizado" description="Quiz realizado" profile_data={profile_data}>
   <!-- bento card style -->
   <div id="quiz-display-container">
      <Card>
         <h5 class="card-title">Estructura del quiz</h5>
         <p class="card-text"></p>
         <a href={quiz_structure_url} class="btn btn-primary">Estructura</a>
      </Card>

      <Card>
        <h5 class="card-title">Resultados del quiz</h5>
         <button id="btn-results" class="btn btn-primary">Resultados</button>
      </Card>
   </div>
</Document>

<style>
   #quiz-display-container {
      display: flex;
      justify-content: start;
      align-items: start;
      height: 100%;
   }

   .card-title {
      font-size: 1.5rem;
      font-weight: bold;
   }
   .card-text {
      font-size: 1.2rem;
      color: var(--main-color-blue);
   }
</style>

<script>
   const URL = window?.location?.href?.match(/performed\/([\w-]+)/);
   const performed_id = URL?.[1];
   const btn_results = document.querySelector("#btn-results") as HTMLButtonElement;
   btn_results.addEventListener("click", Get_Quiz_Results);

   function Get_Quiz_Results() {
      fetch(`/request/get/quiz/performed/results/${performed_id}`)
         .then((response) => {
            if (!response.ok) {
               throw new Error("HTTP error " + response.status);
            }
            return response.json();
         })
         .then((response_json) => response_json.data)
         .then((responses_map) => {
            console.log(responses_map);
         })
         .catch((error) => {
            // setTimeout(() => {
            //    window.location.replace("/quiz/view/all");
            // }, 200);
            console.error("Error:", error);
         });
   }
</script>
