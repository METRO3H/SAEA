---
import { Get_Profile_Data } from "@handlers/get_profile_data";
import Document from "@layouts/document.astro";
import QuizStatsActions from "@components/quiz_stats/quiz_stats_actions.astro";
import GoogleFormIcon from "@assets/svg/google-form-icon-240px-cropped.svg";
import GraphMenu from "@components/graph_menu.astro";
import StatsCard from "@components/quiz_stats/stats_card.astro";
import ModeIcon from "@assets/svg/mode_icon.svg";
import HighestGradeIcon from "@assets/svg/highest_grade_icon.svg";
import LowestGradeIcon from "@assets/svg/lowest_grade_icon.svg";
import Badge_Container from "@components/badge_container";

if (!Astro.cookies.has("session_token")) return Astro.redirect("/login");
const session_token = Astro.cookies.get("session_token")?.value as string;
const profile_data = await Get_Profile_Data(session_token);
const quiz_structure_url = Astro.url.origin + "/quiz/create/performed/" + Astro.params.performed_id;
---

<Document title="Quiz realizado" description="Quiz realizado" profile_data={profile_data}>
   <!-- bento card style -->
   <div id="stats-dashboard">
      <div id="quiz-title-distribution">
         <div id="image-container">
            <img src={GoogleFormIcon.src} alt="Google Form Icon" />
         </div>
         <div id="quiz-title-info">
            <h2 id="quiz-title">BOB EL CONSTRUCTOR</h2>
            <p id="quiz-subject">Matematicas</p>
            <ul class="quiz-badge-container">
               <Badge_Container client:load />
            </ul>
         </div>
         <div id="doughnut-chart-container">
            <canvas id="doughnut-chart"></canvas>
         </div>
      </div>

      <!-- Botones de acción aquí -->
      <QuizStatsActions structure_url={quiz_structure_url} />

      <ul id="graph-menu-container">
         <GraphMenu />
      </ul>
      <div id="stats-cards-container">
         <!-- <QuizStatsCards /> -->
         <StatsCard head_label="Promedio" foot_label="Promedio general" element_id="average-grade" />
         <StatsCard
            head_label="Moda"
            foot_label="Calificación más frecuente"
            element_id="mode-grade"
            stat_icon={ModeIcon}
         />
         <StatsCard
            head_label="Maxima"
            foot_label="Calificación más alta"
            element_id="highest-grade"
            stat_icon={HighestGradeIcon}
         />
         <StatsCard
            head_label="Minima"
            foot_label="Calificación más baja"
            element_id="lowest-grade"
            stat_icon={LowestGradeIcon}
         />
      </div>

      <div id="graph-container" slot="overview">
         <!-- Contenido de las Tabs (opcional) -->
         <div class="tab-content" id="overview">
            <canvas id="bar-chart"></canvas>
         </div>

         <div class="tab-content" id="students" style="display: none;">
            <h3>Students Content</h3>
            <p>Aquí va el contenido de students.</p>
         </div>

         <div class="tab-content" id="questions" style="display: none;">
            <h3>Questions Content</h3>
            <p>Aquí va el contenido de questions.</p>
         </div>
      </div>
   </div>
</Document>

<style>
   .cards-container {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      width: 100%;
   }
   #stats-dashboard {
      display: grid;
      grid-template-areas:
         "quiz-title-distribution quiz-title-distribution"
         "quiz-actions quiz-actions"
         "graph-menu quiz-stats-container"
         "graph-container graph-container";

      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto 1fr;
      gap: 1rem 1.5rem;
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      padding: 1rem;
      flex-grow: 1;
      overflow: auto;
   }
   #quiz-title-distribution {
      grid-area: quiz-title-distribution;
      display: flex;

      width: 85%;
      max-height: 250px;
      gap: 2rem;
   }

   #image-container img {
      /* width: 100%; */
      max-width: 300px;
      height: 100%;
   }
   #quiz-title-info {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      flex-grow: 6;
      overflow: hidden;
      max-width: 100%;
      padding-top: 1rem;
   }

   #quiz-title {
      /* font-size: 2rem; */
      font-weight: bold;
      margin: 0;
      align-content: center;
   }
   .quiz-badge-container {
      /* position: relative; */
      display: flex;
      justify-content: flex-start;
      align-content: flex-start;
      gap: 0.5rem;
      margin: 0rem;
      width: 100%;
      flex-wrap: wrap;
      padding: 0;
      flex-grow: 1;
      
   }

   #quiz-subject {
      margin-inline: 0.25rem;
      color: var(--text-secondary);
      font-size: 1.2rem;
   }
   #doughnut-chart-container {
      flex-grow: 3;
   }

   #quiz-success-distribution {
      max-height: 250px;
   }
   #quiz-actions {
      grid-area: quiz-actions;
   }
   #stats-cards-container {
      grid-area: quiz-stats-container;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      width: 100%;
      margin: 0;
      padding: 0;
   }

   #graph-menu-container {
      grid-area: graph-menu;
      display: flex;
      justify-content: flex-start;
      align-items: flex-end;
      gap: 0.5rem;
      list-style: none;
      padding: 0;
      margin: 0;
   }

   #graph-container {
      grid-area: graph-container;
      display: flex;
   }

   /* Estilos para el contenido de las tabs */
   .tab-content {
      padding: 20px;
      background-color: var(--background);
      border-radius: 8px;
      border: 1px solid var(--border);
      flex: 1;
   }

   .tab-content h3 {
      margin-bottom: 10px;
      color: var(--primary);
   }
</style>

<script>
   import type { QuizResult, Quiz, BadgeMap } from "@content/types";
   import { $specifications_table } from "@content/shared/badge_data";
   import {
      Average_Grade,
      Get_Grade_Distribution,
      Get_Grade_Frequency_Map,
      Median_Grade,
      Mode_Grade,
      Pass_Rate,
   } from "@handlers/quiz_stats";
   import { Chart } from "chart.js/auto";
   import ChartDataLabels from "chartjs-plugin-datalabels";
   import annotationPlugin from "chartjs-plugin-annotation";

   Chart.register(annotationPlugin);

   const URL = window?.location?.href?.match(/performed\/([\w-]+)/);
   const performed_id = URL?.[1];

   const update_results_btn = document.querySelector("#update-results-btn") as HTMLButtonElement;
   const link_form_btn = document.querySelector("#link-form-btn") as HTMLAnchorElement;
   const quiz_title = document.querySelector("#quiz-title") as HTMLHeadingElement;
   const quiz_subject = document.querySelector("#quiz-subject") as HTMLParagraphElement;

   update_results_btn?.addEventListener("click", () => {
      update_results_btn.classList.add("loading");
      Update_Quiz_Results(performed_id).then(() => document.location.reload());
   });

   Run_Process();
   async function Run_Process() {
      const quiz_results_response = await Get_Quiz_Results(performed_id);
      if (quiz_results_response === null) {
         console.log("No se pudo obtener los resultados del quiz");
         return;
      }
      const { student_results, quiz_data } = quiz_results_response;

      link_form_btn.href = quiz_data.google_form_url;
      quiz_title.textContent = quiz_data.quiz_title;
      quiz_subject.textContent = quiz_data.quiz_subject;

      console.log(quiz_data);

      $specifications_table.set(quiz_data.specifications_table);

      Show_Graphs(student_results, quiz_data);
   }
   async function Show_Graphs(student_results, quiz_data) {
      const grade_distribution = Get_Grade_Distribution(student_results);

      // console.log(grade_distribution);

      const max_grade_possible = quiz_data.questions.length;
      Doughnut_Graph(grade_distribution, max_grade_possible);
      Stat_Cards(grade_distribution, max_grade_possible);
      Grade_Distribution_Graph(grade_distribution, quiz_data);
   }

   async function Get_Quiz_Results(performed_id): Promise<{ student_results: QuizResult[]; quiz_data: Quiz } | null> {
      try {
         const response = await fetch(`/request/quiz/results/get/${performed_id}`);

         if (!response.ok) {
            throw new Error("HTTP error " + response.status);
         }

         const response_json = await response.json();

         return response_json;
      } catch (error) {
         console.error("Error:", error);
         return null;
      }
   }

   async function Update_Quiz_Results(performed_id) {
      try {
         const response = await fetch(`/request/quiz/results/update/${performed_id}`, {
            method: "POST",
            headers: {
               "Content-Type": "application/json",
            },
         });

         if (!response.ok) {
            throw new Error("HTTP error " + response.status);
         }

         const response_json = await response.json();

         return response_json;
      } catch (error) {
         console.error("Error:", error);
         return null;
      }
   }

   function Grade_Distribution_Graph(grade_distribution, quiz_data) {
      const grade_labels = Array.from({ length: quiz_data.questions.length + 1 }, (_, i) => i);

      const grade_frequency_map = Get_Grade_Frequency_Map(grade_distribution);

      const grade_frequency_data = grade_labels.map((label) => grade_frequency_map[label] ?? 0);

      const graph_data = {
         labels: grade_labels,
         datasets: [
            {
               label: "Estudiantes",
               data: grade_frequency_data,
               borderColor: "rgb(98, 0, 238)",
               backgroundColor: "rgb(98, 0, 238)",
               borderWidth: 1,
            },
         ],
      };
      const config: any = {
         type: "bar",
         data: graph_data,
         options: {
            responsive: true,
            plugins: {
               legend: {
                  display: false,
               },
               title: {
                  display: true,
                  text: "Resultados del quiz",
                  font: {
                     size: 20,
                  },
                  padding: {
                     top: 20,
                     bottom: 20,
                  },
               },
            },
            scales: {
               x: {
                  title: {
                     display: true,
                     text: "Puntaje",
                  },
                  grid: {
                     display: false,
                  },
               },
               y: {
                  title: {
                     display: true,
                     text: "Estudiantes",
                  },
                  min: 0,
                  max: Math.max(1, ...(Object.values(grade_frequency_data) as number[])) + 1,
                  ticks: {
                     stepSize: 1,
                  },
               },
            },
         },
      };

      const line_chart_element = document.getElementById("bar-chart") as HTMLCanvasElement;
      return new Chart(line_chart_element, config);
   }

   function Stat_Cards(grade_distribution, max_grade_possible) {
      const average_grade_element = document.getElementById("average-grade") as HTMLDivElement;
      // const median_grade_element = document.getElementById("median-grade") as HTMLDivElement;
      const mode_grade_element = document.getElementById("mode-grade") as HTMLDivElement;
      // const pass_rate_element = document.getElementById("pass-rate") as HTMLDivElement;
      // const fail_rate_element = document.getElementById("fail-rate") as HTMLDivElement;
      const highest_grade_element = document.getElementById("highest-grade") as HTMLDivElement;
      const lowest_grade_element = document.getElementById("lowest-grade") as HTMLDivElement;

      const average_grade = Average_Grade(grade_distribution);
      const median_grade = Median_Grade(grade_distribution);
      const mode_grade = Mode_Grade(grade_distribution);
      const pass_rate = Pass_Rate(grade_distribution, max_grade_possible);
      const fail_rate = 1 - pass_rate;

      average_grade_element.textContent = average_grade.toFixed(2) + " pts";
      // median_grade_element.textContent = median_grade.toFixed(2);
      mode_grade_element.textContent = mode_grade.join(", ") + " pts";
      // pass_rate_element.textContent = (pass_rate * 100).toFixed(1) + "%";
      // fail_rate_element.textContent = (fail_rate * 100).toFixed(1) + "%";

      highest_grade_element.textContent = grade_distribution[grade_distribution.length - 1] + " pts";
      lowest_grade_element.textContent = grade_distribution[0] + " pts";

      // console.log("Average grade:", average_grade);
      // console.log("Median grade:", median_grade);
      // console.log("Mode grade:", mode_grade);
      // console.log("Pass rate:", pass_rate);
      // console.log("Fail rate:", fail_rate);
   }

   function Doughnut_Graph(grade_distribution, max_grade_possible) {
      const exigency_grade = Math.floor(max_grade_possible * 0.6);
      const pass_grade_distribution = grade_distribution.filter((grade) => grade >= exigency_grade);
      const fail_grade_distribution = grade_distribution.filter((grade) => grade < exigency_grade);

      const MAIN_COLOR = "rgb(101, 0, 255)";

      const graph_data = {
         labels: ["Aprobados", "Reprobados"],
         datasets: [
            {
               label: "Estudiantes",
               data: [pass_grade_distribution.length, fail_grade_distribution.length],
               backgroundColor: [MAIN_COLOR, "rgb(255, 64, 105)"],
               borderColor: "white",
               borderWidth: 3,

               // offset: 3,
            },
         ],
      };

      const config: any = {
         type: "doughnut",
         data: graph_data,
         options: {
            responsive: true,
            cutout: "50%",
            plugins: {
               annotation: {
                  annotations: {
                     dLabel: {
                        type: "doughnutLabel",
                        content: ({ chart }) => ["Total", grade_distribution.length, "Estudiantes"],
                        font: [{ size: 22 }, { size: 28 }, { size: 16 }],
                        color: [MAIN_COLOR, MAIN_COLOR, "grey"],
                        borderColor: MAIN_COLOR,
                        borderWidth: 1,
                        textStrokeColor: MAIN_COLOR,
                        textStrokeWidth: 0.5,
                     },
                  },
               },
               legend: {
                  display: true,
                  position: "bottom",
               },
               datalabels: {
                  formatter: (value: number, context: any) => {
                     const data = context.chart.data.datasets[0].data;
                     const total = data.reduce((sum: number, val: number) => sum + val, 0);
                     const percentage = ((value / total) * 100).toFixed(1) + "%";
                     return percentage;
                  },
                  color: "#fff",
                  font: {
                     // weight: "bold",
                     size: 14,
                     lineHeight: 1.2,
                     family: "Atkinson",
                  },
                  // anchor: "center",
                  align: "center",
                  // offset: 5,
               },
            },
         },
         plugins: [ChartDataLabels], // <- importante
      };

      const doughnut_chart_element = document.querySelector("#doughnut-chart") as HTMLCanvasElement;
      return new Chart(doughnut_chart_element, config);
   }
</script>
