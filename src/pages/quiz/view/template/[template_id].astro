---
import Document from "@layouts/document.astro";
import Edit_Quiz from "@layouts/edit_quiz.astro";
import Save_Quiz_Button from "@components/buttons/save_quiz.astro";
import GoogleForm_btn from "@components/buttons/google_form_btn.astro";
---

<Document title="..." description="Crear Quiz">
  <Edit_Quiz>
    <Save_Quiz_Button slot="save-button" />
    <a slot="google-form-button" id="link-form-btn" href="#" target="_blank">
      <GoogleForm_btn button_text="LINK DEL FORMULARIO" is_generator={false} />
    </a>
  </Edit_Quiz>
</Document>

<script>
  import type { Quiz } from "@content/quiz_data";
  import { quiz_data_store } from "@content/quiz_data";

  const URL = window?.location?.href?.match(/template\/([a-f0-9-]+)/);
  const template_id = URL?.[1];
  const link_form_btn = document.querySelector("#link-form-btn") as HTMLAnchorElement;

  fetch(`/request/get/quiz/template/${template_id}`)
    .then((response) => response.json())
    .then((response_json) => response_json.data)
    .then((quiz_data: Quiz) => {
      console.log(quiz_data);
      quiz_data_store.set(quiz_data);
    })
    .then(() => {
      document.title = quiz_data_store.get().quiz_title;
      link_form_btn.href = quiz_data_store.get().google_form_url;
    })
    .catch((error) => {
      console.error("Error:", error);
    });
</script>
