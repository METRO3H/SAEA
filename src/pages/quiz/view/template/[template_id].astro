---
import Document from "@layouts/document.astro";
import Edit_Quiz from "@layouts/edit_quiz.astro";
---
<Document title="Test Quiz" description="Crear Quiz">

  <Edit_Quiz />

</Document>

<script>
  import type { Quiz } from "@content/quiz_data";
  import { quiz_data_store } from "@content/quiz_data";

  const URL = window?.location?.href?.match(/template\/([a-f0-9-]+)/);
  const template_id = URL?.[1];
  console.log(template_id)

  fetch(`/request/get/quiz/template/${template_id}`)
    .then((response) => response.json())
    .then((response_json) => response_json.data)
    .then((quiz_data: Quiz) => { 
      console.log(quiz_data)
      document.title = quiz_data.quiz_title;
      quiz_data_store.set(quiz_data);
    })
    .catch((error) => {
      console.error("Error:", error);
    });


</script>
