---
import Document from "@layouts/document.astro";
import Search_Input from "@components/search_input.astro";
import Quiz_View_Item from "@components/quiz/quiz_view_item.astro";
const SERVER_URL = import.meta.env.SERVER_URL;

const response = await fetch(`${SERVER_URL}/request/get/quiz/all`);
const data = await response.json();
---

<Document title="Cuestionarios" description="Lista de cuestionarios">
  <div id="main-container">
    <div id="filter-container">
      <div id="searcher-container" class="input-group rounded">
        <Search_Input />
      </div>
      <div id="filter"></div>
    </div>

    <div id="card-container">
      <table class="table table-sm table-hover align-middle mb-0 bg-white">
        <thead class="">
          <tr>
            <th class="text-center">#</th>
            <th>Titulo</th>
            <th class="text-center">Asignatura</th>
            <th class="text-center">Estado</th>
            <th class="text-center">Fecha</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {
            data.map((item) => (
              <Quiz_View_Item
                title={item.test_title}
                subject={item.subject}
                creation_date={item.creation_date}
              />
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Document>

<style>
  #main-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;

    height: 100%;
    width: 100%;
    overflow: auto;

    padding: 15px;
  }
  #card-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 95%;
    width: 705px;
    padding: 15px;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    border-radius: 11px;
    overflow: auto;
  }
  #filter-container {
    display: flex;
    width: 705px;
    margin-bottom: 15px;
  }
  #searcher-container {
    display: flex;
    width: 300px;
  }
</style>
<script>
  const checkbox_containers = document.querySelectorAll(".checkbox-item");
  checkbox_containers.forEach((container) => {
    const checkbox = container.querySelector(".form-check-input") as HTMLInputElement;

    container.addEventListener("click", (event) => {
      if (!checkbox.contains(event.target as Node)) {
        checkbox.checked = !checkbox.checked;
      }
    });
  });
</script>
