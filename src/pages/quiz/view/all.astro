---
import Document from "@layouts/document.astro";
import Search_Input from "@components/search_input.astro";
import Quiz_Table_List from "@components/quiz/quiz_table_list.jsx";
const SERVER_URL = import.meta.env.SERVER_URL;
---

<Document title="Cuestionarios" description="Lista de cuestionarios">
  <div id="main">
    <div id="main-container">
      <div id="filter-container">
        <div id="searcher-container" class="input-group rounded">
          <Search_Input />
        </div>
        <div id="filter-options">
          Cuestionarios
          <ul id="quiz-type-options">
            <li class="quiz-type-options-item-active">
              <span>Todos</span>
              <span>15</span>
            </li>
            <li>
              <span>Plantillas</span>
              <span>15</span>
            </li>
            <li>
              <span>Realizados</span>
              <span>15</span>
            </li>
          </ul>
        </div>
      </div>

      <div id="content-container">
        <h4 id="content-title">Plantillas de cuestionarios</h4>
        <div id="card-container">
          <Quiz_Table_List SERVER_URL={SERVER_URL} client:load />
        </div>
      </div>
    </div>
  </div>
</Document>

<style>
  #main {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }
  #main-container {
    display: grid;
    grid-template-columns: 100px 200px 1fr;
    grid-template-areas: "space list content";
    padding: 15px 15px 0 15px;
    width: 100%;
    height: 100%;
  }
  #filter-container {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 15px;

    grid-area: list;
  }
  #searcher-container {
    display: flex;
    width: 100%;
  }
  #quiz-type-options {
    list-style-type: none;

    padding-left: 5px;
  }
  #quiz-type-options > li {
    display: flex;
    justify-content: space-between;
    width: 100%;
    cursor: pointer;
    padding-inline: 11px;
    font-size: 19px;
    transition: all 150ms linear;
    opacity: 60%;
  }

  .quiz-type-options-item-active {
    background: white;
    border-radius: 11px;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    opacity: 100%!important;
  }

  #content-container {
    display: flex;
    flex-direction: column;
    padding-inline: 15px;
    padding-bottom: 11px;
    grid-area: content;
    overflow: auto;
  }
  #content-title {
    color: var(--main-color-blue);
  }
  #card-container {
    position: relative;
    display: flex;
    flex-direction: column;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 21%);
    border-radius: 11px;
    overflow: auto;
    height: 100%;
  }
</style>

<script>
  // Obtener todos los botones
  const buttons = document.querySelectorAll("#quiz-type-options li");

  // Agregar un event listener a cada botón
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      console.log("bob");
      buttons.forEach((btn) => {
        btn.classList.remove("quiz-type-options-item-active");
      });

      // Agregar la clase 'active' solo al botón clickeado
      button.classList.add("quiz-type-options-item-active");
    });
  });
</script>
