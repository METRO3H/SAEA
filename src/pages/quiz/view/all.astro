---
import Document from "../../../layouts/document.astro";
---

<Document title="Cuestionarios" description="Lista de cuestionarios">
  <div id="card-container">
    <div id="filter-container">
      <div id="searcher-container" class="input-group rounded">
        <input
          type="search"
          class="form-control rounded"
          placeholder="Search"
          aria-label="Search"
          aria-describedby="search-addon"
        />
        <span class="input-group-text border-0" id="search-addon">
          <i class="fas fa-search"></i>
        </span>
      </div>
      <div id="filter"></div>
    </div>

    <table class="table table-hover align-middle mb-0 bg-white">
      <thead class="table-dark">
        <tr>
          <th class="text-center">#</th>
          <th>Name</th>
          <th class="text-center">Status</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th class="checkbox-item" scope="row">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" />
            </div>
          </th>
          <td>
            <div class="d-flex align-items-center">
              <div>
                <p class="fw-bold mb-1">John Doe</p>
                <p class="text-muted mb-0">john.doe@gmail.com</p>
              </div>
            </div>
          </td>

          <td class="status">
            <div>
              <span class="badge badge-success rounded-pill d-inline text-center">Active</span>
            </div>
          </td>
          <td>
            <div class="actions-container">
              <button type="button" class="btn btn-primary btn-floating" data-mdb-ripple-init>
                <i class="far fa-pen-to-square"></i>
              </button>
              <button type="button" class="btn btn-danger btn-floating" data-mdb-ripple-init>
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</Document>

<style is:inline>
  main {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  #card-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 95%;
    width: 705px;
    padding: 15px;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    border-radius: 11px;
    overflow: hidden;
  }
  #filter-container {
    display: flex;
    width: 100%;
    margin-bottom: 15px;
  }
  #searcher-container {
    display: flex;
    width: 300px;
  }
  .actions-container {
    display: flex;
    justify-content: center;
    gap: 5px;
  }
  .status > div {
    display: flex;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .form-check,
  .form-check-input {
    margin: 0 !important;
    padding: 0 !important;
  }
  .form-check {
    display: flex;
    justify-content: center;
  }
  .table {
    padding-inline: 15px;
    border-radius: 11px;
  }
  /*   .actions-container > button{

    transition: transform 300ms ease;
  }
  .actions-container > button:hover{
    transform: scale(1.1);
    
  } */
</style>
<script>
  const checkbox_containers = document.querySelectorAll(".checkbox-item");
  checkbox_containers.forEach((container) => {
    const checkbox = container.querySelector(".form-check-input") as HTMLInputElement;

    container.addEventListener("click", (event) => {

      if (!checkbox.contains(event.target as Node)) {
        checkbox.checked = !checkbox.checked;
      }
    });
  });
</script>
