---
import Document from "@layouts/document.astro";
import Search_Input from "@components/search_input.astro";
import Quiz_Table_List from "@components/quiz_list/quiz_table_list.tsx";
import { Get_Profile_Data } from "@handlers/get_profile_data";

if (!Astro.cookies.has("session_token")) return Astro.redirect("/login");
const session_token =  Astro.cookies.get("session_token")?.value as string;
const profile_data = await Get_Profile_Data(session_token);
---

<Document title="Cuestionarios" description="Lista de cuestionarios" profile_data={profile_data}>
  <div id="main">
    <div id="main-container">
      <div id="filter-container">
        <div id="searcher-container" class="input-group rounded">
          <Search_Input />
        </div>
        <div id="filter-options">
          Cuestionarios
          <ul id="quiz-type-options">
            <li id="drafted" class="quiz-type-options-item-active">
              <span>Borradores</span>
              <span class="type-counter">-</span>
            </li>
            <li id="performed">
              <span>Realizados</span>
              <span class="type-counter">-</span>
            </li>
          </ul>
        </div>
      </div>

      <div id="content-container">
        <h4 id="content-title">Cuestionarios borradores</h4>
        <div id="card-container">
          <Quiz_Table_List client:load />
        </div>
      </div>
    </div>
  </div>
</Document>

<style>
  #main {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }
  #main-container {
    display: grid;
    grid-template-columns: 100px 200px 1fr;
    grid-template-areas: "space list content";
    padding: 15px 15px 0 15px;
    width: 100%;
    height: 100%;
  }
  #filter-container {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 15px;

    grid-area: list;
  }
  #searcher-container {
    display: flex;
    width: 100%;
  }
  #quiz-type-options {
    list-style-type: none;

    padding-left: 5px;
  }
  #quiz-type-options > li {
    display: flex;
    justify-content: space-between;
    width: 100%;
    cursor: pointer;
    padding-inline: 11px;
    font-size: 19px;
    transition: all 150ms linear;
    opacity: 60%;
  }
  span.type-counter {
    font-family: roboto, system-ui;
  }

  .quiz-type-options-item-active {
    background: white;
    border-radius: 11px;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    opacity: 100% !important;
  }

  #content-container {
    display: flex;
    flex-direction: column;
    padding-inline: 15px;
    padding-bottom: 11px;
    grid-area: content;
    overflow: auto;
  }
  #content-title {
    color: var(--main-color-blue);
  }
  #card-container {
    position: relative;
    display: flex;
    flex-direction: column;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 21%);
    border-radius: 11px;
    overflow: auto;
    height: 100%;
  }
</style>

<script>
  import { quiz_type_store, quiz_list_length_store } from "@content/quiz_data.ts";

  const buttons = document.querySelectorAll("#quiz-type-options li") as NodeListOf<HTMLLIElement>;
  const list_title = document.querySelector("#content-title") as HTMLHeadingElement;

  buttons.forEach((btn) => {
    btn.addEventListener("click", Handle_Click);
  });

  function Handle_Click(event) {
    const target = event.currentTarget as HTMLLIElement;

    if (target.classList.contains("quiz-type-options-item-active")) return;

    buttons.forEach((btn) => {
      btn.classList.remove("quiz-type-options-item-active");
    });

    target.classList.add("quiz-type-options-item-active");

    list_title.textContent = !quiz_type_store.get()
      ? "Cuestionarios borradores"
      : "Cuestionarios realizados";

    quiz_type_store.set(!quiz_type_store.get());
  }

  const draft_element = document.querySelector("#drafted .type-counter") as HTMLSpanElement;
  const perform_element = document.querySelector("#performed .type-counter") as HTMLSpanElement;

  quiz_list_length_store.subscribe(($quiz_list_length) => {
    draft_element.textContent = $quiz_list_length.draft.toString();

    perform_element.textContent = $quiz_list_length.performed.toString();
  });
</script>
