---
import CreateQuiz from "@layouts/create_quiz.astro";
---

<CreateQuiz />

<script>
  import { data_test_2 } from "@content/Test/create_quiz/data_test_1";

  import { Fill_data_table, Fill_Questions } from "@content/Test/create_quiz/fill_dom";

  document.addEventListener("DOMContentLoaded", () => {
    Fill_data_table(data_test_2);
  });

  const button_next_part = document.querySelector("#button-next-part");

  button_next_part?.addEventListener("click", () => {
    setTimeout(Fill_Questions, 50, data_test_2);
  });
</script>
