---
import { Image } from "astro:assets";
import Google_Icon from "@assets/svg/google-icon.svg"
import QuestionListItem from "@components/question/question_list_item.astro";
import QuestionContentItem from "@components/question/question_content_item.astro";
import { question_number } from "@components/question/const_var";
import Document from "@layouts/document.astro";
import Specifications from "@layouts/specifications.astro";
import Modal from "@components/modal.astro";
---

<Document title="Crear Quiz" description="Crear Quiz">
  <div id="main-container">
    <div id="movable-container">
      <div id="specs-container">
        <Specifications />
      </div>
      <div id="create-questions-container">
        <div id="question-card-container">
          <div id="question-list-container">
            <div class="list-group list-group-light" id="list-tab" role="tablist">
              <QuestionListItem question_list_item_number={question_number} add_class="active" />

              <QuestionListItem question_list_item_number={question_number + 1} />
            </div>
          </div>
          <div id="question-content-container">
            <div class="tab-content">
              <QuestionContentItem
                question_content_item_number={question_number}
                add_class="active"
              />
              <QuestionContentItem question_content_item_number={question_number + 1} />
            </div>
          </div>
          <div id="back-part-div">
            <button id="button-back-part" class="btn btn-secondary btn-rounded"
              ><i class="fas fa-arrow-rotate-left"></i>Atrás</button
            >
          </div>
          <div id="footer-card-buttons">
            <button type="button" id="button-save-data-form" class="btn btn-lg btn-rounded">
              <i class="far fa-bookmark"></i>
              <span> Guardar</span>
            </button>

            <button
              type="button"
              id="button-generate-google-form"
              class="btn btn-lg btn-rounded"
              data-mdb-ripple-init
              data-mdb-modal-init
              data-mdb-target="#staticBackdrop"
              disabled
            >
              <Image src={Google_Icon} alt= "Google icon"/>
              <span>GENERAR FORMULARIO</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <Modal modal_id="staticBackdrop" />
  </div>
</Document>

<style>
  #main-container {
    height: 100%;
    width: 100%;
    overflow: hidden;
  }
  #movable-container {
    display: flex;
    height: 100%;
    width: 200%;
    transition: transform 500ms;
    overflow: hidden;
  }
  #specs-container {
    display: flex;
    justify-content: center;
    height: 100%;
    width: 50%;
  }
  #create-questions-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    width: 50%;
  }
  #question-card-container {
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-rows: minmax(0, 1fr) 80px;
    grid-template-areas:
      "list content"
      "back_button buttons";
    width: 805px;
    height: 95%;
    /* min-height: 530px; */
    margin: 0;
    padding: 0;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    border-radius: 11px;
    overflow: hidden;
  }
  #question-content-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* background: green; */
    max-height: 100%;
    grid-area: content;
    overflow: auto;
  }
  #question-list-container {
    width: 180px;
    padding: 0;
    grid-area: list;
  }
  .tab-content {
    height: 100%;
    width: 100%;
    max-height: 100%;
    overflow: auto;
  }
  #back-part-div {
    display: flex;
    justify-content: center;
    align-items: center;
    grid-area: back_button;
  }
  #button-back-part {
    /*  background: #e70034 !important; */
    color: var(--main-color-blue-light);
    height: fit-content;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  #footer-card-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    grid-area: buttons;
  }
  #button-save-data-form {
    display: flex;
    justify-content: center;
    gap: 4px;
    align-items: center;
    background: var(--main-color-blue);
    color: white;
  }

  #button-save-data-form > i {
    padding-bottom: 2.2px;
  }
  #button-generate-google-form {
    display: flex;
    justify-content: center;
    gap: 4px;
    background: #6200ee;
    color: white;
  }
  #button-generate-google-form > img {
    width: 20px;
  }

  @media (max-width: 805px) {
    #question-card-container {
      width: 100%;
    }
  }
</style>
<script>
  document.querySelector("#button-back-part")?.addEventListener("click", () => {
    const movable_container = document.querySelector("#movable-container") as HTMLDivElement;
    movable_container.style.transform = "translateX(0%)";
  });

  interface Quiz {
    title: string;
    created_by: number;
    specifications_table: {
      subject: string;
      skills: string[];
      total_questions: string;
      table_body: {
        thematic_area: string;
        content: string;
        objective: string;
        performed_classes: string;
        skills: string[];
      }[];
    };
    questions: {
      text: String;
      answers: {
        text: String;
        is_correct: boolean;
      }[];
    }[];
  }
  let quiz_data: Quiz;

  const button_next_part = document.querySelector("#button-next-part");
  button_next_part?.addEventListener("click", Update_Specification_Data);

  const button_save_form = document.querySelector("#button-save-data-form") as HTMLInputElement;
  const button_generate_google_form = document.querySelector(
    "#button-generate-google-form"
  ) as HTMLInputElement;

  button_save_form?.addEventListener("click", () => {
    Update_Questions_Data();
    Save_Form();
  });

  button_generate_google_form!.addEventListener("click", Generate_Google_Form);

  function Update_Specification_Data() {
    const movable_container = document.querySelector("#movable-container") as HTMLDivElement;

    movable_container.style.transform = "translateX(-50%)";

    const table = document.querySelector(".custom-container");

    const quiz_title = (table?.querySelector("#quiz-title div input")! as HTMLInputElement).value;

    const quiz_subject = (table?.querySelector("#table-subject input")! as HTMLInputElement).value;

    const quiz_skills = Array.from(
      table?.querySelectorAll(".thead-input input")! as NodeListOf<HTMLInputElement>
    ).map((input) => input.value);

    const quiz_total_questions = (
      table?.querySelector("#item-total-all-questions input")! as HTMLInputElement
    ).value;

    quiz_data = {
      title: quiz_title,
      created_by: 1,
      specifications_table: {
        subject: quiz_subject,
        skills: quiz_skills,
        total_questions: quiz_total_questions,
        table_body: [],
      },
      questions: [],
    };

    const All_TR = table?.querySelectorAll("tbody tr") as NodeListOf<HTMLElement>;

    let [thematic_area_aux, content_aux] = ["", ""];

    All_TR.forEach((tr) => {
      let thematic_area = (tr.querySelector(".item-thematic-area") as HTMLInputElement)?.value;

      if (thematic_area || thematic_area == "") {
        thematic_area_aux = thematic_area;
      }

      let content = (tr.querySelector(".item-content") as HTMLInputElement)?.value;

      if (content || content == "") {
        content_aux = content;
      }

      /* const content */
      quiz_data.specifications_table.table_body.push({
        thematic_area: thematic_area ?? thematic_area_aux,
        content: content ?? content_aux,
        objective: (tr.querySelector(".item-objetive") as HTMLInputElement).value,
        performed_classes: (tr.querySelector(".item-class") as HTMLInputElement).value,
        skills: Array.from(tr.querySelectorAll(".item-skill") as NodeListOf<HTMLInputElement>).map(
          (item) => item.value
        ),
      });
    });

    console.log(quiz_data);
  }
  function Save_Form() {
    button_generate_google_form?.removeAttribute("disabled");
    button_save_form.setAttribute("disabled", "");
    console.log(quiz_data);

    fetch("/request/save_form", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(quiz_data),
    })
      .then(async (response) => {
        if (!response.ok) {
          const errorResponse = await response.json();
          throw errorResponse || "Error en la solicitud";
        }
        return response.json();
      })
      .then((response) => {
        End_Animation(response, false);
      })
      .catch((error) => {
        console.error(error);
        End_Animation(error, true);
      });
  }
  function Generate_Google_Form() {}

  function Update_Questions_Data() {
    const questions = document.querySelectorAll(".question-content-item");

    quiz_data.questions = [];

    questions.forEach((question_item) => {
      const question_text = (
        question_item.querySelector(".question-input-text") as HTMLTextAreaElement
      ).value;

      const answers = question_item.querySelectorAll(".question-answers .form-check");

      const answers_data: {
        text: string;
        is_correct: boolean;
      }[] = [];

      answers.forEach((answer, index) => {
        const answer_text = (answer.querySelector(".answer-input-text") as HTMLInputElement).value;
        const answer_value = (answer.querySelector(".answer-input-box") as HTMLInputElement)
          .checked;

        // Agregar la pregunta y si es correcta al array de datos
        answers_data.push({
          text: answer_text,
          is_correct: answer_value,
        });
      });

      quiz_data.questions.push({
        text: question_text,
        answers: answers_data,
      });
    });
  }

  function End_Animation(response, is_error) {
    (document.querySelector(".check-mark") as HTMLDivElement).style.display = "block";

    document.documentElement.style.setProperty("--cicleFlow", "forwards");
    document.documentElement.style.setProperty(
      "--finalBorder",
      "rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231)"
    );
    document.documentElement.style.setProperty("--h1Animation", "h1-animation-2");

    const modal_message_container = document.querySelector(
      "#modal-message-container"
    ) as HTMLElement;

    modal_message_container.innerHTML = `
            <h3 id="modal-message-text"> ${response.message} </h3>
          `;

    const btn_close_modal = document.querySelector(".btn-close-modal") as HTMLElement;

    btn_close_modal.style.height = "51px";
    btn_close_modal.style.paddingTop = "var(--mdb-btn-padding-top)";
    btn_close_modal.style.paddingBottom = "var(--mdb-btn-padding-bottom)";
    btn_close_modal.style.paddingTop = "var(--mdb-btn-padding-top)";
    btn_close_modal.style.paddingBottom = "var(--mdb-btn-padding-bottom)";

    if (!is_error) {
      const btn_link_form = document.querySelector(".btn-link-form") as HTMLLinkElement;
      btn_link_form.href = response.URL;
      btn_link_form.style.height = "51px";
      btn_link_form.style.width = "auto";
      btn_link_form.style.paddingTop = "var(--mdb-btn-padding-top)";
      btn_link_form.style.paddingBottom = "var(--mdb-btn-padding-bottom)";
      btn_link_form.style.paddingLeft = "var(--mdb-btn-padding-x)";
      btn_link_form.style.paddingRight = "var(--mdb-btn-padding-x)";
      return;
    }

    return;
  }
</script>
