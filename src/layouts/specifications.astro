---
import SpecialInputText from "../components/special_input_text.jsx";
import Custom_table from "../components/table/table.jsx";
---

<div class="custom-container">
  <div id="quiz-title">
    <SpecialInputText
      input_label="Título del cuestionario"
      label_font_size="28px"
      label_class="fw-bold"
      bar_thickness="3px"
      input_width="45%"
      input_min_width="310px"
      input_height="60px"
      input_font_size="31px"
      input_no_focus_color="rgba(34, 41, 57)"
      input_class="fw-bold"
    />
  </div>
  <Custom_table client:load />
  <div id="next-part-div">
    <button id="button-next-part" class="btn btn-primary"
      ><i class="fas fa-forward"></i> Siguiente
    </button>
  </div>
</div>

<style>
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    height: 100%;
    width: 95%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding-top: 1rem;
    gap: 8px;
  }
  #next-part-div {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-top: 11px;
    margin-bottom: 11px;
  }
  #button-next-part {
    display: flex;
    align-items: center;
    gap: 5px;
    background: rgb(34, 41, 57) !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>(".cell input").forEach((input: HTMLInputElement) => {
    const parent = input.parentNode as HTMLElement;
    const original_title = parent.title;
    input.addEventListener("change", function () {
      if (input.offsetWidth < input.scrollWidth) {
        parent.title = input.value;
      } else {
        parent.title = original_title;
      }
    });
  });

  const button_next_part = document.querySelector("#button-next-part");
  button_next_part?.addEventListener("click", () => {
    const movable_container = document.querySelector("#movable-container") as HTMLDivElement;

    movable_container.style.transform = "translateX(-50%)";

    const table = document.querySelector(".custom-container");

    const quiz_title = (table?.querySelector("#quiz-title div input")! as HTMLInputElement).value;

    const quiz_subject = (table?.querySelector("#table-subject input")! as HTMLInputElement).value;

    const quiz_skills = Array.from(
      table?.querySelectorAll(".thead-input input")! as NodeListOf<HTMLInputElement>
    ).map((input) => input.value);

    const total_questions = (
      table?.querySelector("#item-total-all-questions input")! as HTMLInputElement
    ).value;

    const quiz_data: {
      title: string;
      created_by: number;
      specifications_table: {
        subject: string;
        skills: string[];
        total_questions: string;
        table_body: {
          thematic_area: string;
          content: string;
          objective: string;
          performed_classes: string;
          skills: string[];
        }[];
      };
      questions: [];
    } = {
      title: quiz_title,
      created_by: 1,
      specifications_table: {
        subject: quiz_subject,
        skills: quiz_skills,
        total_questions: total_questions,
        table_body: [],
      },
      questions: [],
    };

    const All_TR = table?.querySelectorAll("tbody tr") as NodeListOf<HTMLElement>;

    let [thematic_area_aux, content_aux] = ["", ""];

    All_TR.forEach((tr) => {
      let thematic_area = (tr.querySelector(".item-thematic-area") as HTMLInputElement)?.value;

      if (thematic_area || thematic_area == "") {
        thematic_area_aux = thematic_area;
      }

      let content = (tr.querySelector(".item-content") as HTMLInputElement)?.value;

      if (content || content == "") {
        content_aux = content;
      }


      /* const content */
      quiz_data.specifications_table.table_body.push({
        thematic_area: thematic_area ?? thematic_area_aux,
        content: content ?? content_aux,
        objective: (tr.querySelector(".item-objetive") as HTMLInputElement).value,
        performed_classes: (tr.querySelector(".item-class") as HTMLInputElement).value,
        skills: Array.from(tr.querySelectorAll(".item-skill") as NodeListOf<HTMLInputElement>).map(
          (item) => item.value
        ),
      });
    });

    console.log(quiz_data);
  });
</script>
