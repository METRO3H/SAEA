---
import Specifications_Table from "@components/table/Specifications_Table.tsx";
import Special_Input_Text from "../components/special_input_text.jsx";

---

<div id="specs-container">
  <div class="custom-container">
    <div id="quiz-title">
      <Special_Input_Text
        input_label="Título del cuestionario"
        label_class="fw-bold"
        bar_thickness="3px"
        input_width="45%"
        input_font_size="31px"
        input_no_focus_color="var(--main-color-blue)"
        input_class="fw-bold"
        input_icon_class="fas fa-book"
      />
    </div>

    <div id="table-container">
      <Specifications_Table client:only="react" />
    </div>
  </div>

  <div id="next-part-div">
    <button id="button-next-part" class="btn btn-primary"
      ><i class="fas fa-forward"></i> Siguiente
    </button>
  </div>
</div>

<style>
  #table-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    height: 100%;
    width: 100%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 1rem 0;
    gap: 8px;
  }
  #next-part-div {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-top: 11px;
    margin-bottom: 11px;
  }
  #button-next-part {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--main-color-blue) !important;
  }
  #specs-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    width: 50%;
    /* border: 2px solid red; */
    padding: 1rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>(".cell input").forEach((input: HTMLInputElement) => {
    const parent = input.parentNode as HTMLElement;
    const original_title = parent.title;
    input.addEventListener("change", function () {
      if (input.offsetWidth < input.scrollWidth) {
        parent.title = input.value;
      } else {
        parent.title = original_title;
      }
    });
  });
</script>
