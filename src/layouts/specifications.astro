---
import SpecialInputText from "../components/special_input_text.jsx";
import Custom_table from "../components/table/table.jsx";
---

<div class="custom-container">
  <div id="quiz-title">
    <SpecialInputText
      input_label="Título del cuestionario"
      label_font_size="28px"
      label_class="fw-bold"
      bar_thickness="3px"
      input_width="45%"
      input_min_width="310px"
      input_height="60px"
      input_font_size="31px"
      input_no_focus_color="var(--main-color-blue)"
      input_class="fw-bold"
    />
  </div>
  <Custom_table client:load />
  <div id="next-part-div">
    <button id="button-next-part" class="btn btn-primary"
      ><i class="fas fa-forward"></i> Siguiente
    </button>
  </div>
</div>

<style>
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    height: 100%;
    width: 95%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding-top: 1rem;
    gap: 8px;
  }
  #next-part-div {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-top: 11px;
    margin-bottom: 11px;
  }
  #button-next-part {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--main-color-blue) !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLInputElement>(".cell input").forEach((input: HTMLInputElement) => {
    const parent = input.parentNode as HTMLElement;
    const original_title = parent.title;
    input.addEventListener("change", function () {
      if (input.offsetWidth < input.scrollWidth) {
        parent.title = input.value;
      } else {
        parent.title = original_title;
      }
    });
  });


</script>
