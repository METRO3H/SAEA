
<div id="main-container">
  <div id="movable-container">
    <div id="specs-container">
      <div id="quiz-title">
        <slot name="quiz-title" />
      </div>

      <div id="table-container">
        <slot name="specifications-table" />
      </div>

      <div id="next-part-div">
        <button id="button-next-part" class="btn btn-primary"
          ><i class="fas fa-forward"></i> Siguiente
        </button>
      </div>
    </div>

    <div id="create-questions-container">
      <div id="question-card-container">
        <slot name="questions-data" />

        <div id="footer-card-buttons">
          <div id="back-part-div">
            <button id="button-back-part" class="btn btn-secondary btn-rounded"
              ><i class="fas fa-arrow-rotate-left"></i>Atrás</button
            >
          </div>

          <div id="work-buttons">
            <slot name="save-button" />
            <slot name="google-form-button" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <slot name="modal" />
</div>

<style>
  #main-container {
    display: none;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }
  #movable-container {
    display: flex;
    height: 100%;
    width: 200%;
    transition: transform 500ms;
    overflow: hidden;
  }

  #create-questions-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 50%;
  }
  #question-card-container {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr) 80px;
    grid-template-areas:
      "main_content"
      "buttons";
    width: 805px;
    height: 95%;

    margin: 0;
    padding: 0;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    border-radius: 11px;
    overflow: hidden;
  }

  #back-part-div {
    display: flex;
    justify-content: center;
    align-items: center;
    /* grid-area: back_button; */
  }
  #button-back-part {
    /*  background: #e70034 !important; */
    color: var(--main-color-blue-light);
    height: fit-content;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  #footer-card-buttons {
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-areas: "back-button work-buttons";
    grid-area: buttons;
  }

  #work-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 11px;
    grid-area: work-buttons;
  }

  @media (max-width: 805px) {
    #question-card-container {
      width: 100%;
    }
  }

  #table-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    height: 100%;
    width: 100%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 1rem 0;
    gap: 8px;
  }
  #next-part-div {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-top: 11px;
    margin-bottom: 11px;
  }
  #button-next-part {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--main-color-blue) !important;
  }
  #specs-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    width: 50%;
    /* border: 2px solid red; */
    padding: 1rem;
  }
</style>

<script>
  const button_next_part = document.querySelector("#button-next-part");
  button_next_part?.addEventListener("click", () => {
    Move_Container("-50%");
  });
  const button_back_part = document.querySelector("#button-back-part");
  button_back_part?.addEventListener("click", () => {
    Move_Container("0%");
  });

  function Move_Container(movement) {
    const movable_container = document.querySelector("#movable-container") as HTMLDivElement;

    movable_container.style.transform = `translateX(${movement})`;
  }
</script>
