---
import "@styles/questions_data.css";
import { Image } from "astro:assets";
import Google_Icon from "@assets/svg/google-icon.svg";
import Document from "@layouts/document.astro";
import Specifications from "@layouts/specifications.astro";
import Questions_Data from "@components/question/questions_data.jsx";
import Modal from "@components/modal.astro";
import GoogleFormBtn from "@components/google_form_btn.astro";
---

<Document title="Crear Quiz" description="Crear Quiz">
  <div id="main-container">
    <div id="movable-container">
      <div id="specs-container">
        <Specifications />
      </div>
      <div id="create-questions-container">
        <div id="question-card-container">
          <Questions_Data client:load />

          <div id="footer-card-buttons">
            <div id="back-part-div">
              <button id="button-back-part" class="btn btn-secondary btn-rounded"
                ><i class="fas fa-arrow-rotate-left"></i>Atrás</button
              >
            </div>
            <div id="work-buttons">
              <button type="button" id="button-save-data-form" class="btn btn-lg btn-rounded">
                <i class="far fa-bookmark"></i>
                <span> Guardar</span>
              </button>

              <GoogleFormBtn />
            </div>
          </div>
        </div>
      </div>
    </div>

    <Modal />
  </div>
</Document>

<style>
  #main-container {
    height: 100%;
    width: 100%;
    overflow: hidden;
  }
  #movable-container {
    display: flex;
    height: 100%;
    width: 200%;
    transition: transform 500ms;
    overflow: hidden;
  }
  #specs-container {
    display: flex;
    justify-content: center;
    height: 100%;
    width: 50%;
  }
  #create-questions-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 50%;
  }
  #question-card-container {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr) 80px;
    grid-template-areas:
      "main_content"
      "buttons";
    width: 805px;
    height: 95%;

    margin: 0;
    padding: 0;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    border-radius: 11px;
    overflow: hidden;
  }

  #back-part-div {
    display: flex;
    justify-content: center;
    align-items: center;
    /* grid-area: back_button; */
  }
  #button-back-part {
    /*  background: #e70034 !important; */
    color: var(--main-color-blue-light);
    height: fit-content;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  #footer-card-buttons {
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-areas: "back-button work-buttons";
    grid-area: buttons;
  }
  #button-save-data-form {
    display: flex;
    justify-content: center;
    gap: 4px;
    align-items: center;
    background: var(--main-color-blue);
    color: white;
    grid-area: back-button;
  }
  #work-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 11px;
    grid-area: work-buttons;
  }

  #button-save-data-form > i {
    padding-bottom: 2.2px;
  }

  @media (max-width: 805px) {
    #question-card-container {
      width: 100%;
    }
  }
</style>

