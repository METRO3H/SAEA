---
import AddItemButton from "../components/add_item_button.astro";


---

<div
  class="tab-pane fade show active"
  id="list-home"
  role="tabpanel"
  aria-labelledby="list-home-list"
>
  <h2 class="h1 fw-bold">
    <i class="far fa-circle-question trailing"></i> Pregunta 1
  </h2>
  <hr />
  <div class="form-outline" data-mdb-input-init>
    <i class="fas fa-circle-question trailing"></i>
    <textarea class="form-control" id="textAreaExample" rows="1"></textarea>
    <label class="form-label" for="textAreaExample">Pregunta</label>
  </div>

  <AddItemButton
    button_text_content="Añadir respuesta"
    button_color="btn-outline-primary"
  />
</div>
