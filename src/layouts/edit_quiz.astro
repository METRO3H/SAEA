---

import Specifications_Table from "@components/table/Specifications_Table.tsx";
import Quiz_Title from "@components/table/quiz_title.tsx";
import Questions_Data from "@components/question/questions_data.tsx";
import Modal from "@components/modal.astro";
import Google_Icon from "@assets/svg/google-icon.svg";
import { Image } from "astro:assets";
---


<div id="main-container">
  <div id="movable-container">
    <div id="specs-container">
      <div id="quiz-title">
        <Quiz_Title client:only="react" />
      </div>

      <div id="table-container">
        <Specifications_Table client:only="react" />
      </div>

      <div id="next-part-div">
        <button id="button-next-part" class="btn btn-primary"
          ><i class="fas fa-forward"></i> Siguiente
        </button>
      </div>
    </div>

    <div id="create-questions-container">
      <div id="question-card-container">
        <Questions_Data client:only="react" />

        <div id="footer-card-buttons">
          <div id="back-part-div">
            <button id="button-back-part" class="btn btn-secondary btn-rounded"
              ><i class="fas fa-arrow-rotate-left"></i>Atrás</button
            >
          </div>
          <div id="work-buttons">
            <button type="button" id="button-save-data-form" class="btn btn-lg btn-rounded">
              <i class="far fa-bookmark"></i>
              <span> Guardar</span>
            </button>

            <button
              type="button"
              id="button-generate-google-form"
              class="btn btn-lg btn-rounded"
              data-mdb-ripple-init
              data-mdb-modal-init
              data-mdb-target="#staticBackdrop"
              disabled
            >
              <Image src={Google_Icon} alt="Google icon" />
              <span>GENERAR FORMULARIO</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Modal />
</div>

<style>
  #main-container {
    height: 100%;
    width: 100%;
    overflow: hidden;
  }
  #movable-container {
    display: flex;
    height: 100%;
    width: 200%;
    transition: transform 500ms;
    overflow: hidden;
  }

  #create-questions-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 50%;
  }
  #question-card-container {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr) 80px;
    grid-template-areas:
      "main_content"
      "buttons";
    width: 805px;
    height: 95%;

    margin: 0;
    padding: 0;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    border-radius: 11px;
    overflow: hidden;
  }

  #back-part-div {
    display: flex;
    justify-content: center;
    align-items: center;
    /* grid-area: back_button; */
  }
  #button-back-part {
    /*  background: #e70034 !important; */
    color: var(--main-color-blue-light);
    height: fit-content;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  #footer-card-buttons {
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-areas: "back-button work-buttons";
    grid-area: buttons;
  }
  #button-save-data-form {
    display: flex;
    justify-content: center;
    gap: 4px;
    align-items: center;
    background: var(--main-color-blue);
    color: white;
    grid-area: back-button;
  }
  #work-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 11px;
    grid-area: work-buttons;
  }

  #button-save-data-form > i {
    padding-bottom: 2.2px;
  }

  @media (max-width: 805px) {
    #question-card-container {
      width: 100%;
    }
  }

  #table-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .custom-container {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    height: 100%;
    width: 100%;
    overflow: auto;
    flex-direction: column;
  }
  #quiz-title {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 1rem 0;
    gap: 8px;
  }
  #next-part-div {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-top: 11px;
    margin-bottom: 11px;
  }
  #button-next-part {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--main-color-blue) !important;
  }
  #specs-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    width: 50%;
    /* border: 2px solid red; */
    padding: 1rem;
  }

  #button-generate-google-form {
    display: flex;
    justify-content: center;
    gap: 4px;
    background: var(--main-color-google-form);
    color: white;
  }
  #button-generate-google-form > img {
    width: 20px;
  }
</style>


<script>
  import { quiz_data_store } from "@content/quiz_data";

  const Save_quiz_data_btn = document.querySelector("#button-save-data-form") as HTMLButtonElement;
  const Generate_Google_Form_btn = document.querySelector(
    "#button-generate-google-form"
  ) as HTMLButtonElement;

  Save_quiz_data_btn?.addEventListener("click", Save_Quiz_Data);
  Generate_Google_Form_btn?.addEventListener("click", Generate_Google_Form);

  function Save_Quiz_Data() {
    fetch(`/request/quiz/save`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(quiz_data_store.get()),
    })
      .then((response) => response.json())
      .then((response_json) =>
        quiz_data_store.set({
          ...quiz_data_store.get(),
          quiz_id: response_json.data,
        })
      )
      .then(() => Generate_Google_Form_btn.removeAttribute("disabled"))
      .then(() => Save_quiz_data_btn.setAttribute("disabled", ""))
      .catch((error) => console.error(error));
  }

  function Generate_Google_Form() {
    fetch("/request/quiz/generate", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(quiz_data_store.get()),
    })
      .then((response) => {
        if (!response.ok) {
          throw Error("Error al generar formulario!");
        }
        return response.json();
      })
      .then((response) => {
        End_Animation(
          {
            ...response,
            message: "Formulario generado con éxito!",
          },
          false
        );
      })
      .then(() => Generate_Google_Form_btn.setAttribute("disabled", ""))
      .catch((error) => {
        console.error(error);
        End_Animation(error, true);
      });
  }

  function End_Animation(response, is_error) {
    (document.querySelector(".check-mark") as HTMLDivElement).style.display = "block";

    document.documentElement.style.setProperty("--cicleFlow", "forwards");
    document.documentElement.style.setProperty(
      "--finalBorder",
      "rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231)"
    );
    document.documentElement.style.setProperty("--h1Animation", "h1-animation-2");

    // const modal_message_container = document.querySelector(
    //   "#modal-message-container"
    // ) as HTMLDivElement;

    const modal_message_text = document.querySelector("#modal-message-text") as HTMLDivElement;
    modal_message_text.textContent = response.message || "";

    const btn_close_modal = document.querySelector(".btn-close-modal") as HTMLElement;

    btn_close_modal.style.height = "51px";
    btn_close_modal.style.paddingTop = "var(--mdb-btn-padding-top)";
    btn_close_modal.style.paddingBottom = "var(--mdb-btn-padding-bottom)";
    btn_close_modal.style.paddingTop = "var(--mdb-btn-padding-top)";
    btn_close_modal.style.paddingBottom = "var(--mdb-btn-padding-bottom)";

    if (is_error) return;

    const btn_link_form = document.querySelector(".btn-link-form") as HTMLLinkElement;
    btn_link_form.href = response.data;
    btn_link_form.style.height = "51px";
    btn_link_form.style.width = "auto";
    btn_link_form.style.paddingTop = "var(--mdb-btn-padding-top)";
    btn_link_form.style.paddingBottom = "var(--mdb-btn-padding-bottom)";
    btn_link_form.style.paddingLeft = "var(--mdb-btn-padding-x)";
    btn_link_form.style.paddingRight = "var(--mdb-btn-padding-x)";

    return;
  }
</script>

<script>
  const button_next_part = document.querySelector("#button-next-part");
  button_next_part?.addEventListener("click", () => {
    Move_Container("-50%");
  });
  const button_back_part = document.querySelector("#button-back-part");
  button_back_part?.addEventListener("click", () => {
    Move_Container("0%");
  });

  function Move_Container(movement) {
    const movable_container = document.querySelector("#movable-container") as HTMLDivElement;

    movable_container.style.transform = `translateX(${movement})`;
  }
</script>
