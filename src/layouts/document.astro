---
import BaseHead from "@layouts/BaseHead.astro";
import Header from "@layouts/Header.astro";
import Footer from "@layouts/Footer.astro";

const { title, description, show_header = true, profile_data = null } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    {show_header && <Header profile_data={profile_data} />}
    <main>
      <slot />
    </main>
    <Footer />
    <style></style>
  </body>
</html>
