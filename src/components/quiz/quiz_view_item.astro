---
const { title, subject, creation_date } = Astro.props;
---

<tr>
  <th class="checkbox-item" scope="row">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" />
    </div>
  </th>
  <td>
    <div class="d-flex align-items-center">
      <div>
        <p class="mb-1">{title}</p>
      </div>
    </div>
  </td>
  <td>
    <div class="align-items-center text-center mb-1">
      {subject}
    </div>
  </td>
  <td class="status">
    <div class="mb-1">
      <span class="badge badge-success rounded-pill d-inline text-center">Active</span>
    </div>
  </td>
  <td>
    <div class="creation_date_item align-items-center text-center mb-1">
      {creation_date}
    </div>
  </td>
  <td>
    <div class="actions-container">
      <button type="button" class="btn btn-primary btn-floating" data-mdb-ripple-init>
        <i class="far fa-pen-to-square"></i>
      </button>
      <button type="button" class="btn btn-danger btn-floating" data-mdb-ripple-init>
        <i class="fas fa-trash"></i>
      </button>
    </div>
  </td>
</tr>

<style>
  .actions-container {
    display: flex;
    justify-content: center;
    gap: 5px;
  }
  .status > div {
    display: flex;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .form-check,
  .form-check-input {
    margin: 0 !important;
    padding: 0 !important;
  }
  .form-check {
    display: flex;
    justify-content: center;
  }
  .table {
    padding-inline: 15px;
    border-radius: 11px;
  }
  .creation_date_item {
    font-family: Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
  }
    .actions-container > button{

    transition: transform 300ms ease;
  }
  .actions-container > button:hover{
    transform: scale(1.1);
    
  }
</style>
