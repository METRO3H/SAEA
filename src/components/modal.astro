//   myModalEl?.addEventListener("hidden.bs.modal", (event) => {
//     console.log(modal_instance)
//     modal_instance.dispose()
//     console.log(modal_instance)

//   });

</script>
<style>
  .fade {
    transition: opacity 300ms linear;
    backdrop-filter: blur(2.5px);
  }
  .modal-dialog-centered {
    justify-content: center;
    font-size: medium;
  }
  @media (min-width: 576px) {
    .modal-dialog-centered {
      max-width: 100%;
    }
  }
  .modal-element {
    display: flex;
    flex-direction: column;
    justify-content: center;
    row-gap: 30px;
    align-items: center;
    background: transparent;

    box-shadow: none !important;
  }
  .modal-content-gap {
    row-gap: 10px;
  }

  .modal-footer {
    /* height: 0; */
    padding-bottom: 0;
    overflow: hidden;
    transition: all 500ms ease-in;
  }

  .btn-link-form {
    display: flex;
    align-items: center;
    background: var(--main-color-google-form);
    transition: all 500ms ease-in;
    height: 0;
    padding: 0;
    width: 0;
    overflow: hidden;
    gap: 6px;
  }
  .btn-link-form ~ span {
    font-size: larger;
  }
  .btn-link-form > img {
    width: 25px;
  }
  .btn-close-modal {
    display: flex;
    align-items: center;
    height: 0px;
    overflow: hidden;
    transition: all 500ms ease-in;
    padding-top: 0;
    padding-bottom: 0;
  }

  .lds-dual-ring {
    position: relative;
    display: inline-block;
    width: 164px;
    height: 164px;
  }
  #modal-message-text {
    color: rgb(215, 215, 231);
    text-shadow: 0px 0px 1% rgb(215, 215, 231);
    animation: var(--h1Animation) 1500ms linear var(--cicleFlow);
  }
  @keyframes h1-animation-1 {
    50% {
      text-shadow: 0px 0px 26px darkblue;
      transform: scale(104%, 104%);
    }
  }
  @keyframes h1-animation-2 {
    0% {
      opacity: 0.1;
    }
    50% {
      opacity: 0.3;
      text-shadow: 0px 0px 26px darkblue;
      transform: scale(104%, 104%);
    }

    100% {
      opacity: 1;
      text-shadow: 0px 0px 26px darkblue;
      transform: scale(104%, 104%);
    }
  }
  .lds-dual-ring:after {
    content: "";
    display: block;
    width: 164px;
    height: 164px;
    border-radius: 50%;
    border: 11px solid;
    border-color: var(--finalBorder);
    animation: lds-dual-ring 3s linear var(--cicleFlow);
  }
  @keyframes lds-dual-ring {
    0% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(180deg) scale(110%, 110%);
      border-color: darkblue transparent darkblue transparent;
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @keyframes ring-transition {
    0% {
      transform: rotate(0deg);
      border-color: transparent transparent transparent transparent;
    }
    33% {
      transform: rotate(180deg) scale(110%, 110%);
      border-color: darkblue darkblue transparent transparent;
    }
    66% {
      border-color: darkblue darkblue darkblue darkblue;
    }
    100% {
      transform: rotate(360deg);
      border-color: rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231);
    }
  }
  .modal-backdrop.show {
    opacity: 58%;
  }
  .check-mark {
    display: none;
  }
  .check-mark::after {
    position: absolute;
    top: 55%;
    left: 31%;
    content: "";
    transform: scaleX(-1) rotate(135deg);
    border-top: 11px solid transparent;
    border-right: 11px solid transparent;
    transform-origin: left top;
    animation: animationCheck 1500ms ease-out forwards;
  }

  @keyframes animationCheck {
    0% {
      height: 0;
      width: 0;
      opacity: 0;
    }
    20% {
      width: 10px;
      height: 0;
      opacity: 0.2;
    }
    40% {
      width: 33px;
      height: 0;
      opacity: 0.4;
    }
    80% {
      width: 33px;
      height: 70px;
      opacity: 0.8;
    }
    100% {
      width: 33px;
      height: 70px;
      border-top: 11px solid rgb(215, 215, 231);
      border-right: 11px solid rgb(215, 215, 231);
      opacity: 1;
    }
  }
</style>
