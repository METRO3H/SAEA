---
import { Image } from "astro:assets";
import Google_Icon from "@assets/svg/google-icon.svg";

---

<a
  role="button"
  class="btn btn-link-form btn-lg text-white"
  data-mdb-ripple-init
  target="_blank"
  title="Quiz URL"
  aria-disabled="true"

>
  <Image src={Google_Icon} alt="Google icon" />
  <span>Link del formulario</span>
</a>



<style>
    .btn-link-form {
    display: flex;
    align-items: center;
    background: var(--main-color-google-form);
    transition: all 500ms ease-in;
    height: 0;
    padding: 0;
    width: 0;
    overflow: hidden;
    gap: 6px;
  }
  .btn-link-form ~ span {
    font-size: larger;
  }
  .btn-link-form > img {
    width: 25px;
  }
</style>