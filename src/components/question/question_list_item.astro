---
const {
  question_list_item_number,
  add_class = "",
} = Astro.props;
---

<a
  class=`list-group-item list-group-item-action ${add_class} px-3 border-0`
  id=`question-list-item-${question_list_item_number}`
  data-mdb-list-init
  href=`#question-content-item-${question_list_item_number}`
  role="tab"
  aria-controls=`question-content-item-${question_list_item_number}`
  ><i class="fas fa-circle-question"></i> Pregunta {question_list_item_number}
</a>
