---
import AnswerItemLayout from "./answer_item_layout.jsx";
const { question_content_item_number, add_class = "" } = Astro.props;
---

<div
  class=`tab-pane show question-content-item ${add_class}`
  id=`question-content-item-${question_content_item_number}`
  role="tabpanel"
  aria-labelledby=`question-list-item-${question_content_item_number}`
>
  <div class="badge-container">
    <span class="badge rounded-pill badge-primary">Asignatura</span>
    <span class="badge rounded-pill badge-secondary">Eje</span>
    <span class="badge rounded-pill badge-warning">Contenido</span>
    <span class="badge rounded-pill badge-danger">Objetivo</span>
    <span class="badge rounded-pill badge-success">Habilidad</span>
  </div>

  <div id="question-content-title-container">
    <h2 class="h1 fw-bold">
      <i class="far fa-circle-question trailing"></i> Pregunta {question_content_item_number}
    </h2>
  </div>
  <hr />
  <form class=`question-answers`>
    <div class="form-outline" data-mdb-input-init>
      <i class="fas fa-circle-question trailing"></i>
      <textarea class="form-control question-input-text" id="textAreaExample" rows="1"></textarea>
      <label class="form-label" for="textAreaExample">Pregunta</label>
    </div>
    <AnswerItemLayout client:load />
  </form>
</div>

<style is:global>
  .question-content-item {
    height: 100%;
    padding: 21px;
    padding-top: 11px;
  }
  .add-item {
    margin-top: 11px;
    margin-left: 21px;
    width: 200px;
  }
  .remove-button {
    margin-left: 15px;
  }
  .answer-items-section {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding-top: 15px;
  }
  #question-content-title-container {
    display: flex;
  }
  .badge-container {
    display: flex;
    justify-content: flex-end;
    gap: 11px;
  }
</style>
