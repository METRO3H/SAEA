---
import AnswerItemLayout from "./answer_item_layout.jsx";
const {question_content_item_number, add_class = ""} = Astro.props;
---

<div
  class=`tab-pane show question-content-item ${add_class}`
  id=`question-content-item-${question_content_item_number}`
  role="tabpanel"
  aria-labelledby=`question-list-item-${question_content_item_number}`
>
  <div id="question-content-title-container">
    <h2 class="h1 fw-bold">
      <i class="far fa-circle-question trailing"></i> Pregunta {
        question_content_item_number
      }
    </h2>

    <button class="btn btn-dark btn-lg btn-rounded save-question-item">
      <i class="far fa-bookmark" style="padding-right: 4px;"></i> GENERAR</button
    >
  </div>
  <hr />
  <form class=`question-answers`>
    <div class="form-outline" data-mdb-input-init>
      <i class="fas fa-circle-question trailing"></i>
      <textarea
        class="form-control question-input-text"
        id="textAreaExample"
        rows="1"></textarea>
      <label class="form-label" for="textAreaExample">Pregunta</label>
    </div>
    <AnswerItemLayout client:load />
  </form>

  <div
    class="modal fade"
    id="staticBackdrop"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    tabindex="-1"
    aria-labelledby="staticBackdropLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-element modal-content">
        <div class="lds-dual-ring">
          <div class="check-mark"></div>
        </div>

        <div id="modal-message-container">
          <h3 id="modal-message-text">Creando cuestionario...</h3>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .add-item {
    margin-top: 11px;
    margin-left: 21px;
    width: 200px;
  }
  .remove-button {
    margin-left: 15px;
  }
  .answer-items-section {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding-top: 15px;
  }
  #question-content-title-container {
    display: flex;
    justify-content: space-between;
  }

  .fade {
    transition: opacity 300ms linear;
  }
  .modal-dialog-centered {
    justify-content: center;
    font-size: medium;
  }
  @media (min-width: 576px) {
    .modal-dialog-centered {
      max-width: 100%;
    }
  }
  .modal-element {
    display: flex;
    flex-direction: column;
    justify-content: center;
    row-gap: 30px;
    align-items: center;
    width: 100%;
    background: transparent;
    box-shadow: none !important;
  }
  .lds-dual-ring {
    position: relative;
    display: inline-block;
    width: 164px;
    height: 164px;
  }
  #modal-message-text {
    color: rgb(215, 215, 231);
    text-shadow: 0px 0px 1% rgb(215, 215, 231);
    animation: var(--h1Animation) 1500ms linear var(--cicleFlow);
  }
  @keyframes h1-animation-1 {
    50% {
      text-shadow: 0px 0px 26px darkblue;
      transform: scale(104%, 104%);
    }
  }
  @keyframes h1-animation-2 {
    0% {
      opacity: 0.1;
    }
    50% {
      opacity: 0.3;
      text-shadow: 0px 0px 26px darkblue;
      transform: scale(104%, 104%);
    }

    100% {
      opacity: 1;
    }
  }
  .lds-dual-ring:after {
    content: "";
    display: block;
    width: 164px;
    height: 164px;
    border-radius: 50%;
    border: 11px solid;
    border-color: var(--finalBorder);
    animation: lds-dual-ring 3s linear var(--cicleFlow);
  }
  @keyframes lds-dual-ring {
    0% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(180deg) scale(110%, 110%);
      border-color: darkblue transparent darkblue transparent;
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @keyframes ring-transition {
    0% {
      transform: rotate(0deg);
      border-color: transparent transparent transparent transparent;
    }
    33% {
      transform: rotate(180deg) scale(110%, 110%);
      border-color: darkblue darkblue transparent transparent;
    }
    66% {
      border-color: darkblue darkblue darkblue darkblue;
    }
    100% {
      transform: rotate(360deg);
      border-color: rgb(215, 215, 231) rgb(215, 215, 231) rgb(215, 215, 231)
        rgb(215, 215, 231);
    }
  }
  .modal-backdrop.show {
    opacity: 88%;
  }
  .check-mark {
    display: none;
  }
  .check-mark::after {
    position: absolute;
    top: 55%;
    left: 31%;
    content: "";
    transform: scaleX(-1) rotate(135deg);
    border-top: 11px solid transparent;
    border-right: 11px solid transparent;
    transform-origin: left top;
    animation: animationCheck 1500ms ease-out forwards;
  }

  @keyframes animationCheck {
    0% {
      height: 0;
      width: 0;
      opacity: 0;
    }
    20% {
      width: 10px;
      height: 0;
      opacity: 0.2;
    }
    40% {
      width: 33px;
      height: 0;
      opacity: 0.4;
    }
    80% {
      width: 33px;
      height: 70px;
      opacity: 0.8;
    }
    100% {
      width: 33px;
      height: 70px;
      border-top: 11px solid rgb(215, 215, 231);
      border-right: 11px solid rgb(215, 215, 231);
      opacity: 1;
    }
  }

  .btn-link-form{
    display: flex;
    align-items: center;
  }
  .btn-link-form ~ span{
    font-size: larger;
  }
</style>
