<html>
  <th class="cell"
    ><input class="text-white text-center" type="text" placeholder="Habilidad" required /></th>
  
</html>
  <style>
    .cell {
      position: relative;
      height: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
    .cell > input {
      background-color: transparent;
      width: 100%;
      height: 100%;
      border: none;
      outline: none;
    }

    .cell::before,
    .cell::after {
      display: var(--display-before-after, none);
      --tooltip-scale: 0;
      --tooltip-background-color: rgb(51, 45, 45);
      --tooltip-border-color: rgb(92, 87, 87);
      --tooltip-arrow-size: 10px;

      position: absolute;
      top: -0.25rem;
      left: 50%;
      transform: translateX(-50%) translateY(var(--tooltip-translate-y, 0))
        scale(var(--tooltip-scale));
      transition: 350ms transform;
      transform-origin: bottom center;
    }
    .cell::before {
      --tooltip-translate-y: calc(-100% - var(--tooltip-arrow-size));
      content: attr(tooltip-content);
      color: white;
      padding: 0.5rem;
      background: var(--tooltip-background-color);
      border-radius: 8px;
      text-align: center;
      height: fit-content;
      width: max-content;
      white-space: normal;
      border: 3px solid var(--tooltip-border-color);
    }
    .cell:hover::before,
    .cell:hover::after {
      --tooltip-scale: 1;
    }
    .cell::after {
      --tooltip-translate-y: calc(-1 * var(--tooltip-arrow-size));
      content: "";
      border: var(--tooltip-arrow-size) solid transparent;
      border-top-color: var(--tooltip-border-color);
      transform-origin: top center;
    }

    .cell-hint::before,
    .cell-hint::after {
      display: block !important;
    }
  </style>
</html>
