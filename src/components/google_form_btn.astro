---
import Google_Icon from "@assets/svg/google-icon.svg";
import { Image } from "astro:assets";
---
<button
type="button"
id="button-generate-google-form"
class="btn btn-lg btn-rounded"
data-mdb-ripple-init
data-mdb-modal-init
data-mdb-target="#staticBackdrop"
disabled
>
<Image src={Google_Icon} alt="Google icon"/>
<span>GENERAR FORMULARIO</span>
</button>


<style>
      #button-generate-google-form {
    display: flex;
    justify-content: center;
    gap: 4px;
    background: var(--main-color-google-form);
    color: white;
  }
  #button-generate-google-form > img {
    width: 20px;
  }
</style>