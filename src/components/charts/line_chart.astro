<canvas id="bar-chart"></canvas>

<script>
   import { Chart } from "chart.js/auto";

   const bar_chart_element = document.getElementById("bar-chart") as HTMLCanvasElement;
   const data = {
      labels: ["Day 1", "Day 2", "Day 3", "Day 4", "Day 5", "Day 6"],
      datasets: [
         {
            label: "Dataset",
            data: [65, 59, 80, 81, 56, 55],
            borderColor: "rgb(255, 99, 132)",
            backgroundColor: "rgb(255, 99, 132, 0.5)",
            pointStyle: "circle",
            pointRadius: 10,
            pointHoverRadius: 15,
         },
      ],
   };
   const config: any = {
      type: "line",
      data: data,
      options: {
         responsive: true,
         plugins: {
            title: {
               display: true,
               text: (ctx) => "Point Style: " + ctx.chart.data.datasets[0].pointStyle,
            },
         },
      },
   };

   const bar_chart = new Chart(bar_chart_element, config);
</script>
