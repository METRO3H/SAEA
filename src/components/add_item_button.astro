---
const { button_text_content, button_color } = Astro.props;
---

<button
  type="button"
  class=`btn ${button_color} btn-lg add-item`
  data-mdb-ripple-init
>
  {button_text_content}
</button>

<script>
  const add_item_button = document.querySelectorAll("button.add-item");
  let answer_item = document
    .querySelector(".form-check")!
    .cloneNode(true) as HTMLElement;
  let iterator = 3;
  // Handle clicks on each button.
  add_item_button.forEach((button) => {
    button.addEventListener("click", () => {
      answer_item.id = `answer-item-${iterator}`;
      button.parentElement?.insertBefore(answer_item, button);
      console.log("BRUF");
      answer_item = answer_item.cloneNode(true) as HTMLElement;
      iterator++;
    });
  });
</script>

<style>
  .add-item {
    margin-top: 11px;
  }
</style>
