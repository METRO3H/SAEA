  color: #343a40;
}

.stats-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: #6c757d;
}

/* Card Body */
.stats-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-grow: 1;
}

.stats-value {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--main-color-google-form );
