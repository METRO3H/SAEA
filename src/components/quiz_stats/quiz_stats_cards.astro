  .stats-card-header, 
  .stats-card-body, 
  .stats-card-footer {
    padding: 0.75rem;
  }
}

/* Animation for data refresh */
@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

.stats-refreshing {
  animation: pulse 1.5s infinite;
}

