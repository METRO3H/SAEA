  height: 1em;
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .stats-card-wide {
    grid-column: span 1;
  }
  
  .stats-dashboard {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    padding: 0.75rem;
  }
}

@media (max-width: 480px) {
  .stats-dashboard {
    grid-template-columns: 1fr;
