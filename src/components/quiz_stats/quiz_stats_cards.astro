  color: #6c757d;
  text-align: center;
}

/* Card Footer */
.stats-card-footer {
  padding: 1rem;
  background-color: #f8f9fa;
  border-top: 1px solid #e9ecef;
  font-size: 0.875rem;
  color: #6c757d;
}

/* Trend Indicators */
.stats-trend {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.stats-trend-positive {
  color: #2ecc71;
