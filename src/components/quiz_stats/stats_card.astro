---
import {Image} from "astro:assets";
import AverageIcon from "@assets/svg/average_icon.svg";
const { head_label, foot_label, element_id, stat_icon = AverageIcon} = Astro.props;
---

<div class="stat-card" data-type="average" title={foot_label}>
    <!-- <div class="stat-card-decoration"></div> -->
    <div class="stat-card-content">
      <div class="stat-card-header">
        <h3 class="stat-card-title">{head_label}</h3>
        <div class="stat-card-icon">
            <Image src={stat_icon} alt="Average Icon" width="16" height="16" />
        </div>
      </div>
      <div class="stat-card-value-container">
        <span id={element_id} class="stat-card-value">...</span>

      </div>
      <p class="stat-card-description">{foot_label}</p>
    </div>
  </div>


<style>
    :root {
  --primary-color: #6200ee;
  --primary-light: rgba(98, 0, 238, 0.1);
  --text-primary: #333333;
  --text-secondary: #666666;
  --card-bg: white;
  --card-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  --card-hover-shadow: 0 4px 12px rgba(0, 0, 0, 0.15);
  --green: #4caf50;
  --green-light: rgba(76, 175, 80, 0.1);
  --red: #f44336;
  --red-light: rgba(244, 67, 54, 0.1);
}

/* Tarjeta Estadística */
.stat-card {
  position: relative;
  background: linear-gradient(to bottom right, var(--card-bg), #f9f5ff);
  border-radius: 8px;
  box-shadow: var(--card-shadow);
  padding: 0.75rem;
  overflow: hidden;
  transition: all 0.3s ease;
  width: 180px; /* Ancho fijo para una tarjeta individual */
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--card-hover-shadow);
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background-color: var(--primary-color);
  opacity: 0.7;
  transition: opacity 0.3s ease;
}

.stat-card:hover::before {
  opacity: 1;
}

.stat-card-decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background-color: var(--primary-color);
  opacity: 0.1;
  transform: translate(30%, -30%);
}

.stat-card-content {
  position: relative;
  z-index: 1;
}

.stat-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.stat-card-title {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-secondary);
  margin: 0;
}

.stat-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background-color: var(--primary-light);
  color: var(--primary-color);
}

.stat-card-value-container {
  display: flex;
  align-items: flex-end;
  gap: 0.25rem;
  margin-bottom: 0.25rem;
}

.stat-card-value {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-card-trend {
  display: flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 500;
  padding: 0.125rem 0.375rem;
  border-radius: 1rem;
}

.stat-card-trend-up {
  color: var(--green);
  background-color: var(--green-light);
}

.stat-card-trend-down {
  color: var(--red);
  background-color: var(--red-light);
}

.stat-card-trend svg {
  margin-right: 0.125rem;
}

.stat-card-description {
  font-size: 0.7rem;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0;
}
</style>