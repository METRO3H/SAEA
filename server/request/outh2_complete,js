// server.js (Example)

const express = require('express');
const { google } = require('googleapis');
const fs = require('fs');
const cors = require('cors');

const app = express();
const port = 8080;

app.use(express.json());
app.use(cors());

// Load client secrets from a local file.
const clientSecretFile = 'client_secret.json';
let clientSecret;
try {
  clientSecret = JSON.parse(fs.readFileSync(clientSecretFile));
} catch (err) {
  console.error('Error loading client secret file:', err);
  process.exit(1);
}

// OAuth 2.0 configuration
const oauth2Client = new google.auth.OAuth2(
  clientSecret.web.client_id,
  clientSecret.web.client_secret,
  clientSecret.web.redirect_uris[0] 
);

// In-memory token storage (replace with a database in production)
const tokenStore = {};

// Route to handle the code exchange
app.post('/api/auth/exchange', async (req, res) => {
  const code = req.body.code;
  if (!code) {
    return res.status(400).json({ error: 'Missing authorization code' });
  }

  try {
    const { tokens } = await oauth2Client.getToken({
      code,
      redirect_uri: clientSecret.web.redirect_uris[0],
    });
    oauth2Client.setCredentials(tokens);

    // Store the tokens (in-memory for now)
    // In a real app, you'd associate this with a user ID
    tokenStore['user1'] = tokens;

    res.json({ message: 'Tokens received and stored', tokens });
  } catch (err) {
    console.error('Error exchanging code for tokens:', err);
    res.status(500).json({ error: 'Failed to exchange code for tokens' });
  }
});

// Example route to access a Google API (e.g., list files in Google Drive)
app.get('/api/drive/files', async (req, res) => {
  // Retrieve tokens from storage (in-memory for now)
  const tokens = tokenStore['user1'];
  if (!tokens) {
    return res.status(401).send('Not authenticated.');
  }

  oauth2Client.setCredentials(tokens);

  const drive = google.drive({ version: 'v3', auth: oauth2Client });
  try {
    const response = await drive.files.list({
      pageSize: 10,
      fields: 'nextPageToken, files(id, name)',
    });
    const files = response.data.files;
    if (files.length === 0) {
      res.send('No files found.');
    } else {
      res.send('Files: ' + files.map((file) => file.name).join(', '));
    }
  } catch (err) {
    console.error('Error accessing Google Drive:', err);
    res.status(500).send('Error accessing Google Drive.');
  }
});

app.listen(port, () => {
  console.log(`Server listening on port ${port}`);
});